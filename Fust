if getgenv().FUST_AimCleanup then
    pcall(getgenv().FUST_AimCleanup)
end

-- ---- Главный цикл ----
local aimConnection
aimConnection = RunService.RenderStepped:Connect(function()
    -- V11: защита от зомби-цикла — если запущен более новый скрипт,
    -- этот цикл отключает сам себя
    if getgenv().FUST_SESSION ~= FUST_SESSION then
        aimConnection:Disconnect()
        return
    end

    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    updateCrosshair(center, Aim.Crosshair)

    if not Aim.Enabled then
        fovCircle.Visible = false
        return
    end

    local part, aimPos = getAimTarget(camera)

    fovCircle.Position = center
    fovCircle.Radius = Aim.FOV
    fovCircle.Color = part and AIM_FOV_ON or AIM_FOV_OFF
    fovCircle.Visible = Aim.ShowFOV

    if part and aimPos then
        -- V16: пока аимбот ведёт цель, слой дрифта отключается —
        -- иначе он примет плавное ведение вверх за отдачу и станет мешать
        AR_AimBusyUntil = os.clock() + 0.15
        local alpha = math.clamp(1 / math.max(Aim.Smooth, 1), 0, 1)
        camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, aimPos), alpha)
    end
end)

getgenv().FUST_AimCleanup = function()
    if aimConnection then
        aimConnection:Disconnect()
        aimConnection = nil
    end
    pcall(function()
        fovCircle:Remove()
    end)
    for i = 1, 4 do
        pcall(function()
            chLines[i]:Remove()
        end)
    end
end

