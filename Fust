local function applyRowStyle(row, isOn)
    local base = row:GetAttribute("WLText") or ""
    if isOn then
        row.BackgroundColor3 = WL_ACCENT
        row.TextColor3 = Color3.fromRGB(255, 255, 255)
        row.Text = "✓ " .. base
