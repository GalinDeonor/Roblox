-- 0.26: АВТО-ПРЕДИКТ. Упреждение считается от дистанции (пуля летит
-- не мгновенно): ~0.5с на 450м, жёсткие пределы сверху/снизу, коэффи-
-- циентом подстраивается под оружие. У ботов и НПС скорость сглажива-
-- ем экспоненциально — их дёрганые рывки не должны трясти прицел.
local velEMA = {}          -- [root] = сглаженная AssemblyLinearVelocity
local velEMALastClean = 0

local function autoLead(dist)
    return math.clamp(dist / 900, 0.1, 1.5) * math.clamp(Aim.AutoPredictK or 1, 0.1, 5)
end

local function getSmoothedVelocity(root, vel)
    if not Aim.AutoPredict then
        return vel
    end
    local old = velEMA[root]
    if not old then
        velEMA[root] = vel
        return vel
    end
    local smooth = old:Lerp(vel, 0.35)
    velEMA[root] = smooth
    return smooth
end

-- Возвращает part, точку наведения (уже с упреждением) и тип цели.
-- Упреждение считается ПОД ЦЕЛЬ: игрок — как настроено (или авто),
-- бот/НПС — авто-упреждение со сглаженной скоростью.
local function getAimTarget(camera)
    local char = LocalPlayer.Character
    local localRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not localRoot then
        return nil
    end

    local camPos = camera.CFrame.Position
    local look = camera.CFrame.LookVector
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    local bestPart, bestPoint, bestType
    local bestScore = math.huge

    local now = os.clock()
    if now - velEMALastClean > 30 then
        velEMALastClean = now
        for root in pairs(velEMA) do
            if not root.Parent then
                velEMA[root] = nil
            end
        end
    end

    -- ИГРОКИ (вайтлист и команда учитываются)
    if Aim.TargetsPlayers ~= false then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer
                and Whitelist[plr.Name] == nil
                and not (Aim.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team) then

                local model = plr.Character
                local hum = model and model:FindFirstChildOfClass("Humanoid")
                local root = model and model:FindFirstChild("HumanoidRootPart")

                if hum and root and hum.Health > 0 then
                    local worldDist = (root.Position - localRoot.Position).Magnitude
                    if worldDist <= Aim.Distance then
                        local part = resolveAimPart(model, Aim.Part)
                        if part then
                            -- Предикт: упреждение по скорости корня (включая транспорт)
                            local vel = root.AssemblyLinearVelocity
                            local lead = Aim.AutoPredict and autoLead(worldDist) or Aim.Prediction
                            local aimPos = part.Position + vel * lead

                            -- Глубина через Dot: WorldToViewportPoint на Delta врёт по Z
                            local toPoint = aimPos - camPos
                            if toPoint:Dot(look) > 0 then
                                local sp = camera:WorldToViewportPoint(aimPos)
                                local screenDist = (center - Vector2.new(sp.X, sp.Y)).Magnitude

                                if screenDist <= Aim.FOV then
                                    if not Aim.WallCheck or not wallBetween(camPos, model, aimPos) then
                                        local score = (Aim.Priority == "Дистанция") and worldDist or screenDist
                                        if score < bestScore then
                                            bestScore = score
                                            bestPart = part
                                            bestPoint = aimPos
                                            bestType = "игрок"
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- БОТЫ И НПС (собирает трекер)
    -- 0.28: фильтр целей по категориям. «Боты и НПС» — это охранники и
    -- мирные; животные и слиперы целятся только если выбраны в «Кого
    -- аимить» (по умолчанию ВЫКЛ — спящие тела не атакуются).
    if Aim.TargetsNPC or Aim.TargetsAnimals or Aim.TargetsSleepers then
        for model in pairs(trackedNPCs) do
            local hum = model and model:FindFirstChildOfClass("Humanoid")
            local root = model and model:FindFirstChild("HumanoidRootPart")

            if hum and root and hum.Health > 0 then
                local aimCat = npcGetCategory(model, hum, root)
                local catWanted =
                    ((aimCat == "Guard" or aimCat == "Peaceful") and Aim.TargetsNPC)
                    or (aimCat == "Animal" and Aim.TargetsAnimals)
                    or (aimCat == "Sleeper" and Aim.TargetsSleepers)
                if not catWanted then
                    continue
                end

                local worldDist = (root.Position - localRoot.Position).Magnitude
                if worldDist <= Aim.Distance then
                    local part = resolveAimPart(model, Aim.Part)
                    if part then
                        -- у ботов/НПС скорость сглаженная — рывки не уводят прицел
                        local vel = getSmoothedVelocity(root, root.AssemblyLinearVelocity)
                        local lead = Aim.AutoPredict and autoLead(worldDist) or Aim.Prediction
                        local aimPos = part.Position + vel * lead

                        local toPoint = aimPos - camPos
                        if toPoint:Dot(look) > 0 then
                            local sp = camera:WorldToViewportPoint(aimPos)
                            local screenDist = (center - Vector2.new(sp.X, sp.Y)).Magnitude

                            if screenDist <= Aim.FOV then
                                if not Aim.WallCheck or not wallBetween(camPos, model, aimPos) then
                                    local score = (Aim.Priority == "Дистанция") and worldDist or screenDist
                                    if score < bestScore then
                                        bestScore = score
                                        bestPart = part
                                        bestPoint = aimPos
                                        bestType = "бот/НПС"
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bestPart, bestPoint, bestType
end

