-- Габарит персонажа в студах (ширина, высота, глубина)
local BOX_SIZE = Vector3.new(4, 6, 2.5)

-- 0.26: полная приборка за одной моделью бота/НПС (ESP спрятать,
-- чамсы убрать, хитбокс вернуть) — без уничтожения отрисовки
local function botCleanupModel(model)
    local ed = botEspDrawings[model]
    if ed then
        hideEspDrawings(ed)
    end

    -- 0.27: сбрасываем кэш категории и таймер лежачей позы
    npcCategoryCache[model] = nil
    npcHorizontalSince[model] = nil

    local hl = model:FindFirstChild("PETUH_BotChams")
    if hl then
        pcall(function()
            hl:Destroy()
        end)
    end

    local orig = npcHitboxOriginals[model]
    if orig then
        pcall(function()
            if orig.Root and orig.Root.Parent then
                orig.Root.Size = orig.Size
                orig.Root.Transparency = orig.Transparency
                orig.Root.CanCollide = orig.CanCollide
                orig.Root.CanQuery = orig.CanQuery
            end
        end)
        npcHitboxOriginals[model] = nil
    end
end

-- Проецирует 8 углов 3D-габарита персонажа на экран.
-- Возвращает левый-верхний угол и размер в пикселях, либо nil,
-- если персонаж за камерой (тогда проекция зеркалится — рисовать нельзя).
-- ВАЖНО: глубину (перед камерой / за камерой) считаем сами через Dot —
-- у Delta WorldToViewportPoint возвращает мусорный Z на большой дистанции,
-- из-за чего ESP пропадал дальше ~300м. X/Y у проекции точные — их берём.
local function getScreenBox(camera, root)
    local camCF = camera.CFrame
    local camPos = camCF.Position
    local look = camCF.LookVector

    local cf = root.CFrame
    local hx, hy, hz = BOX_SIZE.X * 0.5, BOX_SIZE.Y * 0.5, BOX_SIZE.Z * 0.5

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge

    for i = 0, 7 do
        local ox = (i % 2 == 0) and -hx or hx
        local oy = (i % 4 < 2) and -hy or hy
        local oz = (i < 4) and -hz or hz

        local corner = (cf * CFrame.new(ox, oy, oz)).Position

        -- своя глубина: < 0 = точка за плоскостью камеры
        local depth = (corner - camPos):Dot(look)
        if depth <= 0.1 then
            return nil
        end

        local pt = camera:WorldToViewportPoint(corner)

        if pt.X < minX then minX = pt.X end
        if pt.X > maxX then maxX = pt.X end
        if pt.Y < minY then minY = pt.Y end
        if pt.Y > maxY then maxY = pt.Y end
    end

    return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY)
end

-- 0.28: масштаб ESP по дистанции. Возвращает (масштаб, применён ли):
-- 1.0 рядом -> 0.45 на лимите дистанции. Текст не падает ниже читаемого
-- с телефона минимума (клампится там, где масштаб используется).
-- Тумблер «Сжатие ESP по дистанции» возвращает старый фиксированный вид.
local function espDistScale(dist, maxDist)
    if not S.ESP.DistanceScale then
        return 1, false
    end
    local limit = math.max(maxDist or 1000, 100)
    local t = math.clamp(dist / limit, 0, 1)
    return 1 - t * 0.55, true
end

local renderConnection

renderConnection = RunService.RenderStepped:Connect(function()
    -- V11: защита от зомби-цикла — если запущен более новый скрипт,
    -- этот цикл отключает сам себя
    if getgenv().FUST_SESSION ~= FUST_SESSION then
        renderConnection:Disconnect()
        return
    end

    local Camera = Workspace.CurrentCamera
    if not Camera then
        return
    end

    if S.FullBright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
    end

    -- V17: второй проход слоя дрифта — выполняется ПОСЛЕ RenderStepped-
    -- коннектов игры: если игра пишет отдачу коннектом, гасим в тот же кадр
    AR_DriftPass()

    -- V19: второй проход анти-тряски (после RenderStepped-коннектов игры)
    AS_Pass()

    -- V21: туман могли вернуть (погода/зона) — держим выключенным.
    -- FogEnd/FogStart НЕ действуют, если в Lighting стоит Atmosphere —
    -- из-за этого No Fog не работал. Гасим и его (Density/Haze).
    if S.NoFog then
        if Lighting.FogEnd < 100000 then
            Lighting.FogEnd = 100000
        end
        if Lighting.FogStart < 100000 then
            Lighting.FogStart = 100000
        end
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then
            if atm.Density > 0 then
                atm.Density = 0
            end
            if atm.Haze > 0 then
                atm.Haze = 0
            end
        end
    end

    -- V21: трассеры пуль (Beam от выстрела до пули, стиль VOMAGLA)
    updateBullets()

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    -- V14: анти-отдача, слой 2 — сброс CameraOffset («тычок» камеры
    -- через гуманоида, если игра делает отдачу так)
    if AntiRecoil.Enabled and AntiRecoil.Offset and myChar then
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if myHum and myHum.CameraOffset.Magnitude > 0 then
            myHum.CameraOffset = Vector3.new(0, 0, 0)
        end
    end

    -- V14: раз в минуту снимок состояния в журнал — если словишь бан,
    -- последние строки журнала покажут, что было включено в этот момент
    local jnow = os.clock()
    if jnow - AR_LastStateJournal > 60 then
        AR_LastStateJournal = jnow
        pcall(function()
            journal(string.format(
                "СНЯТО: аим=%d (%s|%s) хитбокс=%d есп=%d чамсы=%d АО=%d (откат=%d оффсет=%d дрифт=%d) АТ=%d (крен=%d поз=%d дрожь=%d) фб=%d нг=%d нд=%d трассеры=%d нпс-есп=%d нпс-чамсы=%d нпс-хитбокс=%d автопредикт=%d рюкзак-есп=%d",
                Aim.Enabled and 1 or 0,
                tostring(Aim.Part),
                tostring(Aim.Priority),
                S.Hitbox.Enabled and 1 or 0,
                S.ESP.Enabled and 1 or 0,
                S.ESP.Chams and 1 or 0,
                AntiRecoil.Enabled and 1 or 0,
                AntiRecoil.Rollback and 1 or 0,
                AntiRecoil.Offset and 1 or 0,
                AntiRecoil.Drift and 1 or 0,
                AntiShake.Enabled and 1 or 0,
                AntiShake.Roll and 1 or 0,
                AntiShake.Position and 1 or 0,
                AntiShake.Oscillation and 1 or 0,
                S.FullBright and 1 or 0,
                S.NoGrass and 1 or 0,
                S.NoDecoration and 1 or 0,
                S.Bullets.Enabled and 1 or 0,
                S.NPC.ESP and 1 or 0,
                S.NPC.Chams and 1 or 0,
                S.NPC.HitboxEnabled and 1 or 0,
                Aim.AutoPredict and 1 or 0,
                S.Loot.Enabled and 1 or 0
            ))
        end)
    end

    local hitboxAppliedCount = 0  -- V11: сколько игроков реально расширено в этом кадре

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local isWhitelisted = Whitelist[player.Name] == true

            ---------------- Хитбоксы (V10) ----------------
            -- Работает на ЛЮБОЙ дистанции — больше НЕ зависит от
            -- слайдера «Max Distance» (из-за этой привязки хитбоксы
            -- молча отключались, если слайдер был сбит вниз).
            if root then
                -- запоминаем оригинальные параметры корня один раз,
                -- чтобы вернуть всё как было при выключении
                local orig = hitboxOriginals[player]
                if not orig or orig.Root ~= root then
                    orig = {
                        Root = root,
                        Size = root.Size,
                        Transparency = root.Transparency,
                        CanCollide = root.CanCollide,
                        CanQuery = root.CanQuery,
                    }
                    hitboxOriginals[player] = orig
                end

                local expanded = false
                if S.Hitbox.Enabled and myRoot and not isWhitelisted then
                    expanded = true
                    hitboxAppliedCount = hitboxAppliedCount + 1
                    local targetSize = Vector3.new(S.Hitbox.Size, S.Hitbox.Size, S.Hitbox.Size)
                    pcall(function()
                        if root.Size ~= targetSize then
                            root.Size = targetSize
                        end
                        root.Transparency = S.Hitbox.Transparency
                        root.CanCollide = false
                        root.CanQuery = true
                    end)
                end

                if not expanded then
                    pcall(function()
                        if root.Size ~= orig.Size then
                            root.Size = orig.Size
                        end
                        root.Transparency = orig.Transparency
                        root.CanCollide = orig.CanCollide
                        root.CanQuery = orig.CanQuery
                    end)
                end
            end

            ---------------- Chams (V11: pcall-защита) + чамсы хитбокса (V13) ----------------
            -- 0.26: чамсы — ДО ПОТОЛКА: привязка к «Max Distance» снята.
            -- Highlight (AlwaysOnTop) рисуется на любой дистанции, так что
            -- подсветка видна и на 2000, и на 3000+ метров.
            local highlight = char and char:FindFirstChild("VOMAGLA_Chams")
            local hbHighlight = root and root:FindFirstChild("VOMAGLA_HitboxChams")
            if S.ESP.Enabled and S.ESP.Chams and char and root and myRoot then
                if true then
                    if not highlight and not ChamsCreateBlocked then
                        -- создание Highlight под pcall: если игра блокирует
                        -- инстанс, цикл кадра больше не умирает молча
                        local okH, created = pcall(function()
                            local h = Instance.new("Highlight")
                            h.Name = "VOMAGLA_Chams"
                            h.Adornee = char
                            h.Parent = char
                            return h
                        end)
                        if okH and created then
                            highlight = created
                        else
                            ChamsCreateBlocked = true
                            warn("[FUST] Highlight заблокирован игрой — чамсы отключены")
                        end
                    end

                    if highlight then
                        pcall(function()
                            highlight.FillColor = isWhitelisted and COLOR_WHITELIST or S.ESPColors.Box
                            -- V13: прозрачность чамсов задаётся слайдером
                            -- (раньше считалась автоматически от дистанции)
                            local alpha = math.clamp(S.ESP.ChamsTransparency, 0, 1)
                            highlight.FillTransparency = alpha
                            highlight.OutlineTransparency = alpha * 0.5
                            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            highlight.Enabled = true
                        end)
                    end

                    -- V13: ЧАМСЫ ХИТБОКСА — свой Highlight на расширенном корне:
                    -- контур куба цветом ESP + призрачная заливка (прозрачнее
                    -- тела на 0.2), тело игрока светится внутри куба,
                    -- всё видно сквозь стены (AlwaysOnTop).
                    if S.Hitbox.Enabled and not isWhitelisted then
                        if not hbHighlight and not ChamsCreateBlocked then
                            local okHB, createdHB = pcall(function()
                                local h = Instance.new("Highlight")
                                h.Name = "VOMAGLA_HitboxChams"
                                h.Adornee = root
                                h.Parent = root
                                return h
                            end)
                            if okHB and createdHB then
                                hbHighlight = createdHB
                            else
                                ChamsCreateBlocked = true
                                warn("[FUST] Highlight заблокирован игрой — чамсы хитбокса отключены")
                            end
                        end

                        if hbHighlight then
                            pcall(function()
                                local alphaHB = math.clamp(S.ESP.ChamsTransparency + 0.2, 0, 1)
                                hbHighlight.FillColor = S.ESPColors.Box
                                hbHighlight.OutlineColor = S.ESPColors.Box
                                hbHighlight.FillTransparency = alphaHB
                                hbHighlight.OutlineTransparency = math.clamp(S.ESP.ChamsTransparency * 0.5, 0, 1)
                                hbHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hbHighlight.Enabled = true
                            end)
                        end
                    elseif hbHighlight then
                        pcall(function()
                            hbHighlight:Destroy()
                        end)
                        hbHighlight = nil
                    end
                end
            else
                -- чамсы выключены: чамсы игрока гасим, чамсы хитбокса убираем
                if highlight then
                    pcall(function()
                        highlight.Enabled = false
                    end)
                end
                if hbHighlight then
                    pcall(function()
                        hbHighlight:Destroy()
                    end)
                    hbHighlight = nil
                end
            end

            ---------------- ESP ----------------
            if S.ESP.Enabled and char and root and myRoot and hum and hum.Health > 0 then
                local dist = (root.Position - myRoot.Position).Magnitude
                -- 0.26: гистерезис 6% — на границе радиуса ESP больше
                -- не мигает (рисуем чуть дальше лимита, гасим плавно)
                if dist <= S.ESP.MaxDistance * 1.06 + 10 then
                    local topLeft, boxSize = getScreenBox(Camera, root)

                    -- 0.26: фикс пропадания ESP на 1000-3000м. Раньше
                    -- дальше ~1200м бокс сжимался меньше 1px и исчезал;
                    -- теперь дотягиваем до минимального читаемого размера
                    if topLeft then
                        local MINW, MINH = 7, 10
                        if boxSize.X < MINW or boxSize.Y < MINH then
                            local cx, cy = topLeft.X + boxSize.X * 0.5, topLeft.Y + boxSize.Y * 0.5
                            local w = math.max(boxSize.X, MINW)
                            local h = math.max(boxSize.Y, MINH)
                            topLeft = Vector2.new(cx - w * 0.5, cy - h * 0.5)
                            boxSize = Vector2.new(w, h)
                        end
                        local ed = ensureEspDrawings(player)

                        -- 0.28: масштаб по дистанции — чем дальше игрок,
                        -- тем мельче его бокс, текст и полосы, но не мельче
                        -- читаемого с телефона минимума
                        local sc, scOn = espDistScale(dist, S.ESP.MaxDistance)
                        local pad = (scOn and sc < 0.7) and 1 or 2
                        local nameSize = scOn and math.max(10, math.floor(14 * sc + 0.5)) or 14
                        local distSize = scOn and math.max(10, math.floor(13 * sc + 0.5)) or 13
                        local itemSize = scOn and math.max(10, math.floor(12 * sc + 0.5)) or 12
                        ed.Name.Size = nameSize
                        ed.Distance.Size = distSize
                        ed.Item.Size = itemSize
                        ed.HealthText.Size = scOn and math.max(9, math.floor(11 * sc + 0.5)) or 11
                        ed.Box.Thickness = (scOn and sc >= 0.75) and 2 or 1
                        ed.HealthBarBg.Thickness = scOn and math.max(2, 3 * sc) or 3
                        ed.HealthBar.Thickness = scOn and math.max(1, 1.5 * sc) or 1.5

                        local bx = topLeft.X - pad
                        local by = topLeft.Y - pad
                        local bw = boxSize.X + pad * 2
                        local bh = boxSize.Y + pad * 2
                        local centerX = bx + bw * 0.5

                        if S.ESP.Box then
                            ed.Box.Position = Vector2.new(bx, by)
                            ed.Box.Size = Vector2.new(bw, bh)
                            ed.Box.Color = isWhitelisted and COLOR_WHITELIST or S.ESPColors.Box
                            ed.Box.Visible = true
                        else
                            ed.Box.Visible = false
                        end

                        if S.ESP.Name then
                            ed.Name.Text = player.Name
                            ed.Name.Position = Vector2.new(centerX, by - (nameSize + 4))
                            ed.Name.Color = isWhitelisted and COLOR_WHITELIST or COLOR_DEFAULT
                            ed.Name.Visible = true
                        else
                            ed.Name.Visible = false
                        end

                        if S.ESP.Distance then
                            ed.Distance.Text = math.floor(dist + 0.5) .. "m"
                            ed.Distance.Position = Vector2.new(centerX, by + bh + 4)
                            ed.Distance.Visible = true
                        else
                            ed.Distance.Visible = false
                        end

                        -- V15: предмет в руках (Tool, надетый на персонажа) —
                        -- только чтение, в игру ничего не пишем
                        if S.ESP.Item then
                            local okTool, tool = pcall(function()
                                return char:FindFirstChildOfClass("Tool")
                            end)
                            if okTool and tool then
                                -- если дистанция включена — пишем строкой ниже неё,
                                -- иначе сразу под боксом
                                local itemY = by + bh + (S.ESP.Distance and (distSize + 10) or 4)
                                ed.Item.Text = tool.Name
                                ed.Item.Position = Vector2.new(centerX, itemY)
                                ed.Item.Color = isWhitelisted and COLOR_WHITELIST or Color3.fromRGB(255, 215, 90)
                                ed.Item.Visible = true
                            else
                                ed.Item.Visible = false
                            end
                        else
                            ed.Item.Visible = false
                        end

                        if S.ESP.HealthBar then
                            local maxHp = math.max(hum.MaxHealth, 1)
                            local pct = math.clamp(hum.Health / maxHp, 0, 1)
                            local barX = bx - 7

                            ed.HealthBarBg.From = Vector2.new(barX, by)
                            ed.HealthBarBg.To = Vector2.new(barX, by + bh)
                            ed.HealthBarBg.Visible = true

                            local fillTop = by + bh * (1 - pct)
                            ed.HealthBar.From = Vector2.new(barX, by + bh)
                            ed.HealthBar.To = Vector2.new(barX, fillTop)
                            ed.HealthBar.Color = Color3.fromRGB(
                                math.floor(255 - pct * 255),
                                math.floor(pct * 255),
                                0
                            )
                            ed.HealthBar.Visible = true

                            ed.HealthText.Text = tostring(math.floor(hum.Health + 0.5))
                            ed.HealthText.Position = Vector2.new(barX - 26, fillTop - 5)
                            ed.HealthText.Color = ed.HealthBar.Color
                            ed.HealthText.Visible = true
                        else
                            ed.HealthBarBg.Visible = false
                            ed.HealthBar.Visible = false
                            ed.HealthText.Visible = false
                        end
                    else
                        -- игрок за камерой / проекция невалидна — прячем
                        local ed = espDrawings[player]
                        if ed then
                            hideEspDrawings(ed)
                        end
                    end
                else
                    -- 0.26: за лимитом прячем сразу, а уничтожаем дальше
                    -- (гистерезис) — у границы радиуса больше нет мерцания
                    local ed = espDrawings[player]
                    if ed then
                        hideEspDrawings(ed)
                    end
                    if dist > S.ESP.MaxDistance * 1.25 + 50 then
                        removeEspDrawings(player)
                    end
                end
            else
                removeEspDrawings(player)
            end
        end
    end

    -- ============ 0.26: БОТЫ И НПС — ESP / ЧАМСЫ / ХИТБОКСЫ ============
    -- 0.27: ключ — модель, цвет — по категории (охранники / мирные /
    -- животные / слиперы), ESP категорий не пересекаются.
    -- Хитбоксы НПС — отдельная функция, хитбоксы игроков не трогает.
    local npcActive = S.NPC.ESP or S.NPC.Chams or S.NPC.HitboxEnabled
        or (Aim.Enabled and (Aim.TargetsNPC or Aim.TargetsAnimals or Aim.TargetsSleepers))
    if npcActive then
        local npcHitApplied = 0

        for model in pairs(trackedNPCs) do
            local gone = (not model.Parent) or (not model:IsDescendantOf(Workspace))
            if gone then
                botCleanupModel(model)
                botRemoveDrawings(model)
                trackedNPCs[model] = nil
            else
                local okN, hum = pcall(function()
                    return model:FindFirstChildOfClass("Humanoid")
                end)
                local okR, root = pcall(function()
                    return model:FindFirstChild("HumanoidRootPart")
                end)

                if not (okN and okR and hum and root) then
                    botCleanupModel(model)
                    botRemoveDrawings(model)
                else
                    -- 0.27: категория модели — ровно одна (охранник / мирный /
                    -- животное / слипер); ESP и чамсы красятся её цветом.
                    -- 0.28: категория считается ДО хитбокса — теперь им
                    -- управляют отдельные тумблеры категорий.
                    local catName, catEnabled, catColor = npcGetCategory(model, hum, root)

                    ---------------- Хитбокс НПС ----------------
                    local orig = npcHitboxOriginals[model]
                    if not orig or orig.Root ~= root then
                        orig = {
                            Root = root,
                            Size = root.Size,
                            Transparency = root.Transparency,
                            CanCollide = root.CanCollide,
                            CanQuery = root.CanQuery,
                        }
                        npcHitboxOriginals[model] = orig
                    end

                    -- 0.28: хитбоксы НПС по категориям — охранники и мирные
                    -- как раньше, животные и слиперы только своими тумблерами
                    -- (спящие тела игроков больше не раздуваются по умолчанию)
                    local hbAllowed = (catName == "Guard")
                        or (catName == "Peaceful")
                        or (catName == "Animal" and S.NPC.HitboxAnimals)
                        or (catName == "Sleeper" and S.NPC.HitboxSleepers)
                    if S.NPC.HitboxEnabled and hum.Health > 0 and hbAllowed then
                        npcHitApplied = npcHitApplied + 1
                        local targetSize = Vector3.new(S.NPC.HitboxSize, S.NPC.HitboxSize, S.NPC.HitboxSize)
                        pcall(function()
                            if root.Size ~= targetSize then
                                root.Size = targetSize
                            end
                            root.Transparency = S.NPC.HitboxTransparency
                            root.CanCollide = false
                            root.CanQuery = true
                        end)
                    else
                        pcall(function()
                            if root.Size ~= orig.Size then
                                root.Size = orig.Size
                            end
                            root.Transparency = orig.Transparency
                            root.CanCollide = orig.CanCollide
                            root.CanQuery = orig.CanQuery
                        end)
                    end

                    ---------------- Чамсы НПС (цвет категории, до потолка) ----------------
                    local botChams = model:FindFirstChild("PETUH_BotChams")
                    if S.NPC.Chams and catEnabled then
                        if not botChams and not ChamsCreateBlocked then
                            local okH, created = pcall(function()
                                local h = Instance.new("Highlight")
                                h.Name = "PETUH_BotChams"
                                h.Adornee = model
                                h.Parent = model
                                return h
                            end)
                            if okH and created then
                                botChams = created
                            else
                                ChamsCreateBlocked = true
                                warn("[FUST] Highlight заблокирован игрой — чамсы ботов отключены")
                            end
                        end

                        if botChams then
                            pcall(function()
                                botChams.FillColor = catColor
                                botChams.OutlineColor = catColor
                                botChams.FillTransparency = math.clamp(S.NPC.ChamsTransparency, 0, 1)
                                botChams.OutlineTransparency = math.clamp(S.NPC.ChamsTransparency * 0.5, 0, 1)
                                botChams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                botChams.Enabled = true
                            end)
                        end
                    elseif botChams then
                        pcall(function()
                            botChams:Destroy()
                        end)
                    end

                    ---------------- ESP НПС (цвет категории) ----------------
                    if S.NPC.ESP and catEnabled and hum.Health > 0 and myRoot then
                        local dist = (root.Position - myRoot.Position).Magnitude
                        if dist <= S.NPC.MaxDistance * 1.06 + 10 then
                            local topLeft, boxSize = getScreenBox(Camera, root)

                            if topLeft then
                                -- тот же фикс мелкого бокса, что у игроков
                                local MINW, MINH = 7, 10
                                if boxSize.X < MINW or boxSize.Y < MINH then
                                    local cx, cy = topLeft.X + boxSize.X * 0.5, topLeft.Y + boxSize.Y * 0.5
                                    local w = math.max(boxSize.X, MINW)
                                    local h = math.max(boxSize.Y, MINH)
                                    topLeft = Vector2.new(cx - w * 0.5, cy - h * 0.5)
                                    boxSize = Vector2.new(w, h)
                                end

                                local ed = botEnsureDrawings(model)

                                -- 0.28: тот же масштаб по дистанции у НПС
                                local sc, scOn = espDistScale(dist, S.NPC.MaxDistance)
                                local pad = (scOn and sc < 0.7) and 1 or 2
                                local nameSize = scOn and math.max(10, math.floor(14 * sc + 0.5)) or 14
                                local distSize = scOn and math.max(10, math.floor(13 * sc + 0.5)) or 13
                                local itemSize = scOn and math.max(10, math.floor(12 * sc + 0.5)) or 12
                                ed.Name.Size = nameSize
                                ed.Distance.Size = distSize
                                ed.Item.Size = itemSize
                                ed.HealthText.Size = scOn and math.max(9, math.floor(11 * sc + 0.5)) or 11
                                ed.Box.Thickness = (scOn and sc >= 0.75) and 2 or 1
                                ed.HealthBarBg.Thickness = scOn and math.max(2, 3 * sc) or 3
                                ed.HealthBar.Thickness = scOn and math.max(1, 1.5 * sc) or 1.5

                                local bx = topLeft.X - pad
                                local by = topLeft.Y - pad
                                local bw = boxSize.X + pad * 2
                                local bh = boxSize.Y + pad * 2
                                local centerX = bx + bw * 0.5

                                if S.NPC.Box then
                                    ed.Box.Position = Vector2.new(bx, by)
                                    ed.Box.Size = Vector2.new(bw, bh)
                                    ed.Box.Color = catColor
                                    ed.Box.Visible = true
                                else
                                    ed.Box.Visible = false
                                end

                                if S.NPC.Name then
                                    ed.Name.Text = model.Name
                                    ed.Name.Position = Vector2.new(centerX, by - (nameSize + 4))
                                    ed.Name.Color = catColor
                                    ed.Name.Visible = true
                                else
                                    ed.Name.Visible = false
                                end

                                if S.NPC.Distance then
                                    ed.Distance.Text = math.floor(dist + 0.5) .. "m"
                                    ed.Distance.Position = Vector2.new(centerX, by + bh + 4)
                                    ed.Distance.Color = catColor
                                    ed.Distance.Visible = true
                                else
                                    ed.Distance.Visible = false
                                end

                                if S.NPC.Item then
                                    local okTool, tool = pcall(function()
                                        return model:FindFirstChildOfClass("Tool")
                                    end)
                                    if okTool and tool then
                                        local itemY = by + bh + (S.NPC.Distance and (distSize + 10) or 4)
                                        ed.Item.Text = tool.Name
                                        ed.Item.Position = Vector2.new(centerX, itemY)
                                        ed.Item.Color = catColor
                                        ed.Item.Visible = true
                                    else
                                        ed.Item.Visible = false
                                    end
                                else
                                    ed.Item.Visible = false
                                end

                                if S.NPC.HealthBar then
                                    local maxHp = math.max(hum.MaxHealth, 1)
                                    local pct = math.clamp(hum.Health / maxHp, 0, 1)
                                    local barX = bx - 7

                                    ed.HealthBarBg.From = Vector2.new(barX, by)
                                    ed.HealthBarBg.To = Vector2.new(barX, by + bh)
                                    ed.HealthBarBg.Visible = true

                                    local fillTop = by + bh * (1 - pct)
                                    ed.HealthBar.From = Vector2.new(barX, by + bh)
                                    ed.HealthBar.To = Vector2.new(barX, fillTop)
                                    ed.HealthBar.Color = Color3.fromRGB(
                                        math.floor(255 - pct * 255),
                                        math.floor(pct * 255),
                                        0
                                    )
                                    ed.HealthBar.Visible = true

                                    ed.HealthText.Text = tostring(math.floor(hum.Health + 0.5))
                                    ed.HealthText.Position = Vector2.new(barX - 26, fillTop - 5)
                                    ed.HealthText.Color = ed.HealthBar.Color
                                    ed.HealthText.Visible = true
                                else
                                    ed.HealthBarBg.Visible = false
                                    ed.HealthBar.Visible = false
                                    ed.HealthText.Visible = false
                                end
                            else
                                local ed = botEspDrawings[model]
                                if ed then
                                    hideEspDrawings(ed)
                                end
                            end
                        else
                            -- за лимитом ботов: прячем с гистерезисом
                            local ed = botEspDrawings[model]
                            if ed then
                                hideEspDrawings(ed)
                            end
                            if dist > S.NPC.MaxDistance * 1.25 + 50 then
                                botRemoveDrawings(model)
                            end
                        end
                    else
                        -- ESP выключен / бот мёртв: прячем, но не уничтожаем —
                        -- бот заспавнится, и отрисовка вернётся без мигания
                        local ed = botEspDrawings[model]
                        if ed then
                            hideEspDrawings(ed)
                        end
                    end
                end
            end
        end

        NpcHitboxAppliedCount = npcHitApplied
    else
        -- бот-функции выключены: прибираем следы (чамсы, хитбоксы, отрисовка)
        for model in pairs(trackedNPCs) do
            botCleanupModel(model)
        end
        NpcHitboxAppliedCount = 0
    end

    -- ============ 0.29: ESP РЮКЗАКОВ С ЛУТОМ ============
    -- Рюкзаки ищет фоновый скан (модуль 0.29 выше по коду), здесь
    -- только отрисовка: чтение мира + Drawing на своём клиенте.
    if myRoot then
        updateBackpackEsp(Camera, myRoot)
    else
        bpHideAll()
    end

    -- V11: одноразовый отчёт — видно в консоли Delta, что цикл жив
    -- и хитбокс реально применяется
    if HitboxAnnouncePending then
        HitboxAnnouncePending = false
        print("[FUST] Хитбокс применён к " .. tostring(hitboxAppliedCount) .. " игрок(ам), размер " .. tostring(S.Hitbox.Size))
    end

    -- 0.26: одноразовый отчёт по хитбоксам НПС
    if NpcHitboxAnnouncePending then
        NpcHitboxAnnouncePending = false
        print("[FUST] Хитбоксы НПС: применены к " .. tostring(NpcHitboxAppliedCount) .. " модел(ям), размер " .. tostring(S.NPC.HitboxSize))
    end
end)

-- V11: полная очистка ЭТОГО запуска — вызывается при следующем execute.
-- Без неё прошлый цикл оставался зомби и ломал новый запуск.
getgenv().FUST_RenderCleanup = function()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end

    -- 0.28: микро-HUD — убираем панельку и её цикл
    pcall(function()
        if getgenv().FUST_HUDCleanup then
            getgenv().FUST_HUDCleanup()
        end
    end)

    -- V14: отвязываем шаги анти-отдачи и фиксируем выгрузку в журнал
    pcall(function()
        RunService:UnbindFromRenderStep("FUST_AR_Snap")
        RunService:UnbindFromRenderStep("FUST_AR_Restore")
    end)
    pcall(function()
        journal("ВЫГРУЗКА: перезапуск скрипта — старые циклы и чамсы убраны")
    end)

    -- возвращаем хитбоксы к оригиналам
    for _, orig in pairs(hitboxOriginals) do
        pcall(function()
            if orig.Root and orig.Root.Parent then
                orig.Root.Size = orig.Size
                orig.Root.Transparency = orig.Transparency
                orig.Root.CanCollide = orig.CanCollide
                orig.Root.CanQuery = orig.CanQuery
            end
        end)
    end

    -- V21: трассеры пуль — коннект, вся отрисовка и пул Beam-частей
    if bulletConn then
        bulletConn:Disconnect()
        bulletConn = nil
    end
    clearBulletDrawings()
    bulletPoolDestroy()

    -- убираем ESP-отрисовку этого запуска
    for plr in pairs(espDrawings) do
        pcall(removeEspDrawings, plr)
    end

    -- убираем чамсы этого запуска
    pcall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            local c = plr.Character
            local hl = c and c:FindFirstChild("VOMAGLA_Chams")
            if hl then
                hl:Destroy()
            end
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local rhl = r and r:FindFirstChild("VOMAGLA_HitboxChams")
            if rhl then
                rhl:Destroy()
            end
        end
    end)

    -- 0.26: боты и НПС — отрисовка, чамсы, хитбоксы
    pcall(function()
        for model in pairs(botEspDrawings) do
            botRemoveDrawings(model)
        end
    end)
    pcall(function()
        for model in pairs(trackedNPCs) do
            local bhl = model:FindFirstChild("PETUH_BotChams")
            if bhl then
                bhl:Destroy()
            end
        end
        for _, orig in pairs(npcHitboxOriginals) do
            if orig.Root and orig.Root.Parent then
                orig.Root.Size = orig.Size
                orig.Root.Transparency = orig.Transparency
                orig.Root.CanCollide = orig.CanCollide
                orig.Root.CanQuery = orig.CanQuery
            end
        end
        table.clear(npcHitboxOriginals)
    end)

    -- 0.29: рюкзаки с лутом — убираем отрисовку и трекинг
    pcall(function()
        bpRemoveAll()
    end)
end

-- V18: ПОЛНАЯ ДЕАКТИВАЦИЯ по кнопке — возвращает всё как было и убирает меню.
-- Вызывается из кнопки «ВЫКЛЮЧИТЬ СКРИПТ» (Конфиги).
getgenv().FUST_Deactivate = function()
    pcall(function()
        journal("ДЕАКТИВАЦИЯ: скрипт выключен кнопкой")
    end)

    -- 1) прибить маркер сессии: всё, что ещё живо, отключится само
    getgenv().FUST_SESSION = {}

    -- 2) свои циклы, шаги анти-отдачи и следы в мире
    pcall(function()
        getgenv().FUST_RenderCleanup()
    end)
    pcall(function()
        getgenv().FUST_AimCleanup()
    end)
    pcall(function()
        if getgenv().FUST_ASCleanup then
            getgenv().FUST_ASCleanup()
        end
    end)
    getgenv().FUST_ASCleanup = nil

    -- 3) вернуть визуалы
    pcall(function()
        if FullBrightBackup then
            Lighting.Brightness = FullBrightBackup.Brightness
            Lighting.ClockTime = FullBrightBackup.ClockTime
            Lighting.FogEnd = FullBrightBackup.FogEnd
            Lighting.GlobalShadows = FullBrightBackup.GlobalShadows
        end
    end)
    pcall(function()
        if NoFogBackup then
            Lighting.FogEnd = NoFogBackup.FogEnd
            Lighting.FogStart = NoFogBackup.FogStart
        end
    end)
    pcall(function()
        local decor = getgenv().FUST_DecorBackup
        if decor and decor.Parent == nil then
            decor.Parent = Workspace
        end
    end)
    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain and sethiddenproperty then
            sethiddenproperty(terrain, "Decoration", true)
        end
    end)

    -- 4) убрать меню (Unload уничтожает ScreenGui и все коннекты библиотеки)
    if getgenv().Library then
        pcall(function()
            if getgenv().Library.Unload then
                getgenv().Library:Unload()
            elseif getgenv().Library.Exit then
                getgenv().Library:Exit()
            end
        end)
        getgenv().Library = nil
    end

    getgenv().FUST_RenderCleanup = nil
    getgenv().FUST_AimCleanup = nil
    getgenv().FUST_Deactivate = nil
    getgenv().FUST_DecorBackup = nil

    print("[FUST] Скрипт полностью деактивирован. Заново execute — чтобы включить снова.")
end

