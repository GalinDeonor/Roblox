local function normalizeName(raw)
    if type(raw) ~= "string" then
        return ""
    end
    local name = raw:gsub("^%s+", ""):gsub("%s+$", "")
    name = name:gsub("^@", "")
    return name
end

-- Ищет игрока по нику/DisplayName (без учёта регистра), иначе возвращает текст как есть
local function resolveName(raw)
    local name = normalizeName(raw)
    if name == "" then
        return nil
    end
    local lower = string.lower(name)
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.lower(plr.Name) == lower then
            return plr.Name
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.lower(plr.DisplayName) == lower then
            return plr.Name
        end
    end
    return name
end

-- Синхронизирует Whitelist с выбором в дропдауне
local function applyWhitelistFromDropdown(list)
    local newSet = {}
    if type(list) == "table" then
        for _, name in ipairs(list) do
            newSet[name] = true
        end
    end

    local inGame = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        inGame[plr.Name] = true
    end

    -- снимаем тех, кто был выбран через дропдаун и больше не выбран
    for name in pairs(DropdownSelected) do
        if not newSet[name] and inGame[name] then
            Whitelist[name] = nil
        end
    end

    for name in pairs(newSet) do
        Whitelist[name] = true
    end

    DropdownSelected = newSet
end

local function refreshWhitelistDropdown()
    if not WhitelistDropdown then
        return
    end
    pcall(function()
        local names = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                table.insert(names, plr.Name)
            end
        end
        table.sort(names)

        WhitelistDropdown:Refresh(names)

        -- сбрасываем устаревшее состояние мульти-дропдауна
        WhitelistDropdown.Value = {}
        WhitelistDropdown.Items["Value"].Instance.Text = "..."

        -- отмечаем тех, кто уже в вайтлисте
        local selected = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and Whitelist[plr.Name] then
                table.insert(selected, plr.Name)
            end
        end
        if #selected > 0 then
            WhitelistDropdown:Set(selected)
        end
    end)
end

