-- ============ 0.29: РЮКЗАКИ С ЛУТОМ (трекер + ESP добычи) ============
-- Рюкзак, который остаётся после смерти игрока, лежит в Workspace.
-- Игра сама подписывает, чей это лут (подпись у рюкзака — обычно
-- ProximityPrompt «Обыскать», плюс атрибуты Owner/Player), и хранит
-- наполнение. Мы ТОЛЬКО ЧИТАЕМ мир: имена, атрибуты, подписи промптов,
-- количество детей. В игру ничего не отправляется, рисуем Drawing-ом
-- у себя на клиенте — бан-риск ровно такой же, как у обычного ESP.
--
-- Владелец (чей лут): атрибуты Owner/Player (+UserId) -> Value-объекты
-- -> ник игрока из подписи промпта (сравниваем со списком игроков) ->
-- подпись целиком («Рюкзак Ванюши») -> ник в имени модели.
-- Слоты (сколько забито): атрибуты UsedSlots/Slots/ItemCount… ->
-- Value-объекты -> папки-инвентари (считаем предметы) -> число в кнопке
-- промпта («Обыскать (12)»). Не нашли — «слоты ??», тогда диагностика
-- и по её логу паттерны правятся под реальные данные игры.

local trackedBackpacks = {}  -- [inst] = { Info, InfoAt, BBoxCF, BBoxSize, BBoxAt }
local bpDrawings = {}        -- [inst] = { Box, Owner, Slots, Distance }

-- Фрагменты имён. string.lower не меняет кириллицу, поэтому русские
-- слова взяты БЕЗ первой буквы: «кзак» ловит «Рюкзак», «рюкзак» и
-- «РЮКЗАК» — регистр первой буквы не важен.
local BP_NAME_PATTERNS = {
    "кзак", "backpack", "умк", "ешок", "руп", "станк", "роп",
    "corpse", "deadbody", "dead body", "loot", "lootbag", "dropbag",
}
local BP_PROMPT_PATTERNS = { "кзак", "backpack", "лут", "ут", "loot", "обыск", "search" }
local BP_TAGS = { "FustBackpack", "Backpack", "LootBag", "LootBackpack", "Corpse", "FustCorpse", "DeadBody" }

local BP_OWNER_ATTRS = { "owner", "ownername", "ownerplayer", "player", "playername", "creator", "creatorname", "nick", "nickname", "username" }
local BP_OWNERID_ATTRS = { "ownerid", "owneruserid", "userid", "playerid" }
local BP_USED_ATTRS = { "usedslots", "filledslots", "slotsused", "slotstaken", "takenslots", "items", "itemcount", "itemscount", "lootcount", "count", "amount" }
local BP_MAX_ATTRS = { "slotcount", "maxslots", "totalslots", "slotsmax", "capacity", "slots" }
local BP_SLOT_FOLDERS = { "items", "inventory", "slots", "container", "storage", "contents", "content", "loot" }
local BP_OWNER_VALUE_NAMES = { "owner", "ownername", "player", "playername", "ownerplayer" }

local function bpNameLower(inst)
    local okN, nameL = pcall(function()
        return string.lower(tostring(inst.Name))
    end)
    if okN then
        return nameL
    end
    return ""
end

local function bpMatchesFragments(text, patterns)
    for _, pat in ipairs(patterns) do
        if string.find(text, pat, 1, true) then
            return true
        end
    end
    return false
end

-- Подпись лута у игры — обычно ProximityPrompt над рюкзаком
local function bpCheckPromptText(prompt)
    local okT, txt = pcall(function()
        return string.lower(tostring(prompt.ObjectText)) .. " " .. tostring(prompt.ActionText)
    end)
    if not okT or not txt then
        return false
    end
    return bpMatchesFragments(txt, BP_PROMPT_PATTERNS)
end

-- Живые игроки, их персонажи, вьюмодел камеры и НПС — не лут
local function bpIsEligibleInstance(inst)
    if not inst or not inst.Parent then
        return false
    end
    if not inst:IsA("Model") and not inst:IsA("BasePart") then
        return false
    end
    if not inst:IsDescendantOf(Workspace) then
        return false
    end
    local cam = Workspace.CurrentCamera
    if cam and inst:IsDescendantOf(cam) then
        return false
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        local c = plr.Character
        if c and (c == inst or inst:IsDescendantOf(c)) then
            return false
        end
    end
    if trackedNPCs[inst] then
        return false
    end
    if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
        return false
    end
    return true
end

local function bpMatchesLoot(inst)
    if bpMatchesFragments(bpNameLower(inst), BP_NAME_PATTERNS) then
        return true
    end
    local okP, prompt = pcall(function()
        return inst:FindFirstChildOfClass("ProximityPrompt")
    end)
    if okP and prompt and bpCheckPromptText(prompt) then
        return true
    end
    return false
end

local function bpTryTrack(inst)
    if trackedBackpacks[inst] then
        return
    end
    if not bpIsEligibleInstance(inst) then
        return
    end
    if bpMatchesLoot(inst) then
        trackedBackpacks[inst] = {}
    end
end

-- ---------- отрисовка (Drawing, как у игроков и ботов) ----------

local function bpEnsureDrawings(inst)
    local ed = bpDrawings[inst]
    if not ed then
        ed = {
            Box = Drawing.new("Square"),
            Owner = Drawing.new("Text"),
            Slots = Drawing.new("Text"),
            Distance = Drawing.new("Text"),
        }
        ed.Box.Filled = false
        ed.Box.Thickness = 1
        for _, key in ipairs({ "Owner", "Slots", "Distance" }) do
            ed[key].Center = true
            ed[key].Outline = true
            ed[key].Font = Drawing.Fonts.Plex
        end
        ed.Owner.Size = 14
        ed.Slots.Size = 13
        ed.Distance.Size = 12
        bpDrawings[inst] = ed
    end
    return ed
end

local function bpRemoveDrawings(inst)
    local ed = bpDrawings[inst]
    if ed then
        for _, obj in pairs(ed) do
            pcall(function()
                obj:Remove()
            end)
        end
        bpDrawings[inst] = nil
    end
end

local function bpHideDrawings(inst)
    local ed = bpDrawings[inst]
    if ed then
        ed.Box.Visible = false
        ed.Owner.Visible = false
        ed.Slots.Visible = false
        ed.Distance.Visible = false
    end
end

local function bpHideAll()
    for inst in pairs(bpDrawings) do
        bpHideDrawings(inst)
    end
end

local function bpRemoveAll()
    for inst in pairs(bpDrawings) do
        bpRemoveDrawings(inst)
    end
    table.clear(trackedBackpacks)
end

-- ---------- габарит и проекция ----------

-- Габарит рюкзака с кэшем (GetBoundingBox не бесплатный)
local function bpGetBBox(inst)
    local e = trackedBackpacks[inst]
    local now = os.clock()
    if e and e.BBoxCF and e.BBoxSize and e.BBoxAt and now - e.BBoxAt < 0.5 then
        return e.BBoxCF, e.BBoxSize
    end
    local cf, sz
    if inst:IsA("Model") then
        local okB, bcf, bsz = pcall(function()
            return inst:GetBoundingBox()
        end)
        if okB and bcf and bsz then
            cf, sz = bcf, bsz
        end
    elseif inst:IsA("BasePart") then
        cf, sz = inst.CFrame, inst.Size
    end
    if not cf or not sz or sz.Magnitude <= 0 then
        return nil
    end
    -- страховка от гигантских «контейнеров» (зоны/склады на полкарты)
    if sz.Magnitude > 60 then
        sz = Vector3.new(2, 2, 2)
    end
    if e then
        e.BBoxCF, e.BBoxSize, e.BBoxAt = cf, sz, now
    end
    return cf, sz
end

-- Проекция 8 углов габарита (та же математика, что у игроков/ботов:
-- глубину считаем сами через Dot — у Delta WorldToViewportPoint врёт
-- с Z на большой дистанции)
local function bpProject(camera, cf, sz)
    local camPos = camera.CFrame.Position
    local look = camera.CFrame.LookVector
    local hx = sz.X * 0.5 + 0.5
    local hy = sz.Y * 0.5 + 0.5
    local hz = sz.Z * 0.5 + 0.5
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    for i = 0, 7 do
        local ox = (i % 2 == 0) and -hx or hx
        local oy = (i % 4 < 2) and -hy or hy
        local oz = (i < 4) and -hz or hz
        local corner = (cf * CFrame.new(ox, oy, oz)).Position
        if (corner - camPos):Dot(look) <= 0.1 then
            return nil
        end
        local pt = camera:WorldToViewportPoint(corner)
        if pt.X < minX then minX = pt.X end
        if pt.X > maxX then maxX = pt.X end
        if pt.Y < minY then minY = pt.Y end
        if pt.Y > maxY then maxY = pt.Y end
    end
    return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY)
end

-- ---------- чтение инфы: владелец + слоты ----------

local function bpReadInfo(inst)
    local owner
    local slotsUsed, slotsMax, itemCount

    -- 1) атрибуты — игра часто пишет владельца и наполнение туда
    local okA, attrs = pcall(function()
        return inst:GetAttributes()
    end)
    if okA and type(attrs) == "table" then
        for key, val in pairs(attrs) do
            local keyL = string.lower(tostring(key))
            if owner == nil and type(val) == "string" and #val > 0 and #val <= 32
                and table.find(BP_OWNER_ATTRS, keyL) then
                owner = val
            end
            if owner == nil and type(val) == "number"
                and table.find(BP_OWNERID_ATTRS, keyL) then
                local okP, plr = pcall(Players.GetPlayerByUserId, Players, val)
                if okP and plr then
                    owner = plr.Name
                end
            end
            if type(val) == "number" then
                if slotsUsed == nil and table.find(BP_USED_ATTRS, keyL) then
                    slotsUsed = val
                end
                if slotsMax == nil and table.find(BP_MAX_ATTRS, keyL) then
                    slotsMax = val
                end
            end
        end
    end

    -- 2) Value-объекты прямо в рюкзаке (StringValue «Owner», IntValue «Slots»)
    local okC, children = pcall(function()
        return inst:GetChildren()
    end)
    if okC and type(children) == "table" then
        for _, ch in ipairs(children) do
            local nameL = string.lower(tostring(ch.Name))
            if ch:IsA("StringValue") then
                if owner == nil and table.find(BP_OWNER_VALUE_NAMES, nameL)
                    and type(ch.Value) == "string" and #ch.Value > 0 and #ch.Value <= 32 then
                    owner = ch.Value
                end
            elseif ch:IsA("ObjectValue") then
                if owner == nil and table.find(BP_OWNER_VALUE_NAMES, nameL)
                    and typeof(ch.Value) == "Instance" then
                    local okV, vName = pcall(function()
                        return tostring(ch.Value.Name)
                    end)
                    if okV then
                        owner = vName
                    end
                end
            elseif ch:IsA("IntValue") or ch:IsA("NumberValue") then
                local v = tonumber(ch.Value)
                if v then
                    if slotsUsed == nil and nameL ~= "slots" and table.find(BP_USED_ATTRS, nameL) then
                        slotsUsed = v
                    end
                    if slotsMax == nil and table.find(BP_MAX_ATTRS, nameL) then
                        slotsMax = v
                    end
                end
            end
        end
    end

    -- 3) подпись промпта: чей лут + число предметов в кнопке
    local okP, prompt = pcall(function()
        return inst:FindFirstChildOfClass("ProximityPrompt")
    end)
    if okP and prompt then
        if owner == nil then
            local okT, title = pcall(function()
                return tostring(prompt.ObjectText)
            end)
            if okT and title and #title > 0 and #title <= 48 then
                local titleL = string.lower(title)
                -- ник игрока прямо в подписи («Рюкзак Dimon4ik»)
                for _, plr in ipairs(Players:GetPlayers()) do
                    local nL = string.lower(plr.Name)
                    local dL = string.lower(plr.DisplayName)
                    if string.find(titleL, nL, 1, true)
                        or (dL ~= nL and #dL > 2 and string.find(titleL, dL, 1, true)) then
                        owner = plr.Name
                        break
                    end
                end
                if owner == nil then
                    -- «Рюкзак Ванюши» -> «Ванюши»; просто «Рюкзак» -> ничего
                    local cleaned = tostring(title):gsub("кзак", ""):gsub("ackpack", ""):gsub("loot", ""):gsub("LOOT", "")
                    cleaned = cleaned:gsub("^[%s%p]+", ""):gsub("[%s%p]+$", "")
                    if #cleaned >= 2 then
                        owner = cleaned
                    end
                end
            end
        end
        if slotsUsed == nil then
            local okAc, actText = pcall(function()
                return tostring(prompt.ActionText)
            end)
            if okAc and actText then
                -- «Обыскать (12)» / «Взять [8]» — число в кнопке
                local num = string.match(actText, "%((%d+)%)")
                    or string.match(actText, "%[(%d+)%]")
                    or string.match(actText, "(%d+)")
                if num then
                    slotsUsed = tonumber(num)
                end
            end
        end
    end

    -- 4) ник в имени модели
    if owner == nil then
        local nameL = bpNameLower(inst)
        if #nameL > 0 then
            for _, plr in ipairs(Players:GetPlayers()) do
                if string.find(nameL, string.lower(plr.Name), 1, true) then
                    owner = plr.Name
                    break
                end
            end
        end
    end

    -- 5) наполнение: папки-инвентари и предметы внутри
    if slotsUsed == nil and okC and type(children) == "table" then
        for _, ch in ipairs(children) do
            if ch:IsA("Folder") or ch:IsA("Model") then
                local nameL = string.lower(tostring(ch.Name))
                if bpMatchesFragments(nameL, BP_SLOT_FOLDERS) then
                    local cnt = 0
                    local okI, items = pcall(function()
                        return ch:GetChildren()
                    end)
                    if okI and type(items) == "table" then
                        for _, item in ipairs(items) do
                            if item:IsA("Tool") or item:IsA("Model") or item:IsA("BasePart")
                                or item:IsA("IntValue") or item:IsA("NumberValue")
                                or item:IsA("StringValue") then
                                cnt = cnt + 1
                            end
                        end
                    end
                    if cnt > 0 then
                        itemCount = math.max(itemCount or 0, cnt)
                    end
                end
            end
        end
        local tools = 0
        for _, ch in ipairs(children) do
            if ch:IsA("Tool") then
                tools = tools + 1
            end
        end
        if tools > 0 then
            itemCount = math.max(itemCount or 0, tools)
        end
    end

    -- 6) слоты текстом: «12/24» -> «12 слот.» -> «N предм.» -> nil
    local slotsText
    if slotsUsed and slotsMax and slotsMax > 0 then
        slotsText = string.format("%d/%d", math.floor(slotsUsed), math.floor(slotsMax))
    elseif slotsUsed then
        slotsText = string.format("%d слот.", math.floor(slotsUsed))
    elseif itemCount then
        slotsText = tostring(itemCount) .. " предм."
    end

    return { Owner = owner, Slots = slotsText }
end

-- ---------- покадровая отрисовка ----------

local function updateBackpackEsp(camera, myRoot)
    -- мусор: рюкзак исчез из мира
    for inst in pairs(trackedBackpacks) do
        if not inst.Parent or not inst:IsDescendantOf(Workspace) then
            bpRemoveDrawings(inst)
            trackedBackpacks[inst] = nil
        end
    end

    if not S.Loot.Enabled or not myRoot then
        bpHideAll()
        return
    end

    local now = os.clock()
    for inst, e in pairs(trackedBackpacks) do
        -- инфа с кэшем 2с: атрибуты/промпты читаем редко — дёшево
        if not e.InfoAt or now - e.InfoAt > 2 then
            e.Info = bpReadInfo(inst)
            e.InfoAt = now
        end

        local cf, sz = bpGetBBox(inst)
        local dist = cf and (cf.Position - myRoot.Position).Magnitude
        if cf and dist and dist <= S.Loot.MaxDistance * 1.06 + 10 then
            local topLeft, boxSize = bpProject(camera, cf, sz)
            if topLeft then
                -- минимальный читаемый размер — как у игроков и ботов
                local MINW, MINH = 8, 11
                if boxSize.X < MINW or boxSize.Y < MINH then
                    local cx, cy = topLeft.X + boxSize.X * 0.5, topLeft.Y + boxSize.Y * 0.5
                    local w = math.max(boxSize.X, MINW)
                    local h = math.max(boxSize.Y, MINH)
                    topLeft = Vector2.new(cx - w * 0.5, cy - h * 0.5)
                    boxSize = Vector2.new(w, h)
                end

                local pad = 2
                local bx = topLeft.X - pad
                local by = topLeft.Y - pad
                local bw = boxSize.X + pad * 2
                local bh = boxSize.Y + pad * 2
                local centerX = bx + bw * 0.5

                local ed = bpEnsureDrawings(inst)
                local info = e.Info or {}

                if S.Loot.Box then
                    ed.Box.Position = Vector2.new(bx, by)
                    ed.Box.Size = Vector2.new(bw, bh)
                    ed.Box.Color = LOOT_COLOR
                    ed.Box.Visible = true
                else
                    ed.Box.Visible = false
                end

                local textY = by + bh + 3
                if S.Loot.Slots then
                    ed.Slots.Text = info.Slots or "слоты ??"
                    ed.Slots.Position = Vector2.new(centerX, textY)
                    ed.Slots.Color = LOOT_COLOR
                    ed.Slots.Visible = true
                    textY = textY + 17
                else
                    ed.Slots.Visible = false
                end

                if S.Loot.Distance then
                    ed.Distance.Text = math.floor(dist + 0.5) .. "m"
                    ed.Distance.Position = Vector2.new(centerX, textY)
                    ed.Distance.Color = LOOT_COLOR
                    ed.Distance.Visible = true
                else
                    ed.Distance.Visible = false
                end

                if S.Loot.Owner and info.Owner then
                    ed.Owner.Text = tostring(info.Owner)
                    ed.Owner.Position = Vector2.new(centerX, by - 18)
                    ed.Owner.Color = LOOT_COLOR
                    ed.Owner.Visible = true
                else
                    ed.Owner.Visible = false
                end
            else
                bpHideDrawings(inst)
            end
        else
            bpHideDrawings(inst)
            if dist and dist > S.Loot.MaxDistance * 1.25 + 50 then
                bpRemoveDrawings(inst)
            end
        end
    end
end

