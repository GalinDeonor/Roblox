-- V17: слой дрифта переработан — ЯКОРЬ + ПЛАВНЫЙ возврат вместо рывка.
-- Почему по-новому: в V16 компенсация начиналась с 3-го кадра (задержка)
-- и вычитала дрифт целиком одним рывком вниз. Теперь при первом плавном
-- подъёме запоминается «якорь» (прицел до отдачи), и каждый кадр камера
-- возвращается к якорю ДОЛЕЙ ошибки — экспоненциально, плавно.
-- Проход идёт дважды за кадр (здесь и в главном рендер-цикле), поэтому
-- без разницы, как именно игра пишет камеру — отдача гасится сразу.
local function AR_DriftPass()
    if not (AntiRecoil.Enabled and AntiRecoil.Drift) then
        AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
        return
    end
    if os.clock() < AR_AimBusyUntil then
        -- аимбот ведёт цель — дрифт ему не мешаем
        AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
        return
    end
    local camera = Workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myTool = myChar and myChar:FindFirstChildOfClass("Tool")
    if not (camera and myTool) then
        -- без оружия в руках отдачи нет — не мешаем смотреть вверх
        AR_LastPitch, AR_DriftFrames, AR_Anchor = nil, 0, nil
        return
    end

    pcall(function()
        local pitch = camera.CFrame.LookVector.Y
        local now = os.clock()

        if AR_LastPitch then
            local d = pitch - AR_LastPitch

            if d < -0.00005 or d > math.rad(2.5) then
                -- движение вниз или резкий флик вверх — это рука игрока
                -- (или восстановление камеры самой игрой): якорь сбрасываем
                AR_DriftFrames = 0
                AR_Anchor = nil
            elseif d > 0.0001 then
                -- плавный подъём = отдача: ставим якорь на прицел до неё
                AR_LastDriftAt = now
                AR_DriftFrames = AR_DriftFrames + 1
                if not AR_Anchor then
                    AR_Anchor = pitch - d
                end
            else
                -- тишина: держим якорь, только пока отдача «свежая» (0.25с) —
                -- между выстрелами серии он умирать не должен
                if now - AR_LastDriftAt > 0.25 then
                    AR_DriftFrames = 0
                    AR_Anchor = nil
                end
            end
        end

        AR_LastPitch = pitch

        if AR_Anchor then
            local err = pitch - AR_Anchor
            if err > 0.0006 then
                -- плавный возврат: доля ошибки за кадр, НЕ рывком.
                -- сила 1 = 60% ошибки за кадр, сила 0.5 = 40%
                local rate = 0.2 + 0.4 * math.clamp(AntiRecoil.DriftStrength, 0, 1)
                local theta = math.asin(math.clamp(err * rate, -1, 1))
                camera.CFrame = camera.CFrame * CFrame.Angles(-theta, 0, 0)
                AR_LastPitch = camera.CFrame.LookVector.Y
            end
        end
    end)
end

-- ==================== V19: АНТИ-ТРЯСКА (три слоя) ====================
-- Гасим тряску камеры при выстреле. Без хуков: только свои записи
-- Camera.CFrame в рендер-цикле (сервер камеру не видит — тот же
-- принцип бан-безопасности, что у анти-отдачи V14+).
-- Проход идёт дважды за кадр (как у дрифта): здесь — после bind-
-- функций игры, второй раз в главном рендер-цикле — после её
-- RenderStepped-коннектов.

-- Подписка на выстрел: Tool.Activated/Deactivated открывают «окно
-- выстрела» (0.3с), в котором работают слои позиции и дрожи.
local function AS_BindTool(tool)
    if tool == AS_LastTool then
        return
    end
    if AS_ToolConns then
        for _, c in ipairs(AS_ToolConns) do
            pcall(function()
                c:Disconnect()
            end)
        end
    end
    AS_ToolConns = nil
    AS_LastTool = tool
    if not tool then
        return
    end
    local conns = {}
    local function markFire()
        if getgenv().FUST_SESSION ~= FUST_SESSION then
            for _, c in ipairs(conns) do
                pcall(function()
                    c:Disconnect()
                end)
            end
            return
        end
        AS_FireUntil = os.clock() + 0.3
    end
    table.insert(conns, tool.Activated:Connect(markFire))
    table.insert(conns, tool.Deactivated:Connect(markFire))
    AS_ToolConns = conns
end

getgenv().FUST_ASCleanup = function()
    if AS_ToolConns then
        for _, c in ipairs(AS_ToolConns) do
            pcall(function()
                c:Disconnect()
            end)
        end
    end
    AS_ToolConns = nil
    AS_LastTool = nil
end

local function AS_Pass()
    local camera = Workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myTool = myChar and myChar:FindFirstChildOfClass("Tool")
    if not (AntiShake.Enabled and camera and myTool) then
        -- без оружия/камеры или выключено — не мешаем смотреть как угодно
        AS_BindTool(nil)
        AS_LastRawPitch, AS_LastDp, AS_LastDy = nil, nil, nil
        AS_LastLX, AS_LastLZ = nil, nil
        AS_AnchorLook, AS_SmoothPos = nil, nil
        AS_PitchFlips, AS_YawFlips = 0, 0
        return
    end
    AS_BindTool(myTool)

    local aimBusy = os.clock() < AR_AimBusyUntil

    pcall(function()
        local cf = camera.CFrame
        local look = cf.LookVector
        local pos = cf.Position
        local now = os.clock()
        local firing = now < AS_FireUntil

        -- СЛОЙ А: КРЕН — наклон камеры вбок. В шутере крен не делает ни
        -- рука игрока, ни камера-контроллер — только эффекты игры.
        if AntiShake.Roll and math.abs(look.Y) < 0.999 then
            local roll = math.asin(math.clamp(cf.RightVector.Y, -1, 1))
            if math.abs(roll) > math.rad(0.05) then
                camera.CFrame = CFrame.lookAt(pos, pos + look)
                cf = camera.CFrame
            end
        end

        -- СЛОЙ Б: ПОЗИЦИЯ — дёрганье камеры взад-вперёд. Только в окне
        -- выстрела: позиция сглаживается экспоненциально, плавное
        -- движение (ходьба) остаётся, дёрганье гасится.
        if AntiShake.Position then
            if firing then
                if AS_SmoothPos and (pos - AS_SmoothPos).Magnitude < 1.5 then
                    AS_SmoothPos = AS_SmoothPos:Lerp(pos, 0.35)
                    camera.CFrame = CFrame.new(AS_SmoothPos) * (cf - cf.Position)
                    cf = camera.CFrame
                else
                    AS_SmoothPos = pos
                end
            else
                AS_SmoothPos = pos
            end
        else
            AS_SmoothPos = nil
        end

        -- СЛОЙ В: ДРОЖЬ ПРИЦЕЛА — взгляд мелко мечется туда-сюда.
        -- Флип = дельта pitch/yaw сменила направление. При первом флипе
        -- ставим якорь «до дрожи» и возвращаем камеру к нему долей за
        -- проход (механика та же, что у слоя дрифта V17).
        if AS_LastRawPitch then
            local lx, lz = look.X, look.Z
            local hh = lx * lx + lz * lz
            local dp = look.Y - AS_LastRawPitch
            local dyaw = 0
            if AS_LastLX and hh > 0.04 and (AS_LastLX * AS_LastLX + AS_LastLZ * AS_LastLZ) > 0.04 then
                local cross = lx * AS_LastLZ - lz * AS_LastLX
                dyaw = math.asin(math.clamp(cross / hh, -1, 1))
            end

            if AntiShake.Oscillation and not aimBusy then
                local bandP = math.abs(dp) > 0.0001 and math.abs(dp) < math.rad(2.5)
                local bandY = math.abs(dyaw) > 0.0001 and math.abs(dyaw) < math.rad(2.5)
                local flipP = bandP and AS_LastDp ~= nil and math.abs(AS_LastDp) < math.rad(2.5) and ((dp > 0) ~= (AS_LastDp > 0))
                local flipY = bandY and AS_LastDy ~= nil and math.abs(AS_LastDy) < math.rad(2.5) and ((dyaw > 0) ~= (AS_LastDy > 0))
                if flipP then
                    AS_PitchFlips = AS_PitchFlips + 1
                else
                    AS_PitchFlips = 0
                end
                if flipY then
                    AS_YawFlips = AS_YawFlips + 1
                else
                    AS_YawFlips = 0
                end

                if (flipP or flipY) and (firing or AS_PitchFlips >= 3 or AS_YawFlips >= 3) then
                    if not AS_AnchorLook then
                        local back = cf
                        if bandP then
                            back = back * CFrame.Angles(-dp, 0, 0)
                        end
                        if bandY then
                            back = back * CFrame.Angles(0, -dyaw, 0)
                        end
                        AS_AnchorLook = back.LookVector
                    end
                    AS_LastShakeAt = now
                    AS_FireUntil = math.max(AS_FireUntil, now + 0.2)
                elseif not bandP and not bandY then
                    -- тишина: якорь живёт 0.25с после последней дрожи
                    if now - AS_LastShakeAt > 0.25 then
                        AS_AnchorLook = nil
                    end
                end

                if AS_AnchorLook and math.abs(AS_AnchorLook.Y) < 0.999 then
                    local dotAng = math.acos(math.clamp(cf.LookVector:Dot(AS_AnchorLook), -1, 1))
                    if dotAng > math.rad(6) then
                        -- якорь устарел (игрок резко отвернулся) — не дёргаем
                        AS_AnchorLook = nil
                    elseif dotAng > 0.0006 then
                        local target = CFrame.lookAt(cf.Position, cf.Position + AS_AnchorLook)
                        camera.CFrame = cf:Lerp(target, 0.55)
                    end
                end
            end

            AS_LastDp = dp
            AS_LastDy = dyaw
        end

        -- сырые значения для следующего прохода — ПОСЛЕ наших коррекций,
        -- чтобы дельта не содержала собственную работу слоёв
        local look2 = camera.CFrame.LookVector
        AS_LastRawPitch = look2.Y
        AS_LastLX = look2.X
        AS_LastLZ = look2.Z
    end)
end

-- Слой 1: снапшот поворота камеры сразу после камера-контроллера
-- (вклад мышки уже учтён), откат кика — в самом конце кадра.
-- Зомби-защита: при повторном execute шаг сам отвязывается по FUST_SESSION.
pcall(function()
    RunService:UnbindFromRenderStep("FUST_AR_Snap")
    RunService:UnbindFromRenderStep("FUST_AR_Restore")
end)

RunService:BindToRenderStep("FUST_AR_Snap", Enum.RenderPriority.Camera.Value + 1, function()
    if getgenv().FUST_SESSION ~= FUST_SESSION then
        RunService:UnbindFromRenderStep("FUST_AR_Snap")
        return
    end
    if not (AntiRecoil.Enabled and AntiRecoil.Rollback) then
        return
    end
    local camera = Workspace.CurrentCamera
    if camera then
        AR_SnapCF = camera.CFrame
    end
end)

RunService:BindToRenderStep("FUST_AR_Restore", Enum.RenderPriority.Last.Value + 1, function()
    if getgenv().FUST_SESSION ~= FUST_SESSION then
        RunService:UnbindFromRenderStep("FUST_AR_Restore")
        return
    end

    -- V17: слой дрифта — якорь + плавный возврат (общая функция).
    -- Этот вызов ловит отдачу, которую игра пишет привязанными
    -- функциями (BindToRenderStep); коннекты игры ловит второй проход
    -- в главном рендер-цикле.
    AR_DriftPass()

    -- V19: анти-тряска — первый проход (bind-функции игры уже отработали)
    AS_Pass()

    -- слой 1: откат резкого КИКА камеры (позиция на месте, рывок вверх)
    if not (AntiRecoil.Enabled and AntiRecoil.Rollback) then
        return
    end
    local camera = Workspace.CurrentCamera
    if not (camera and AR_SnapCF) then
        return
    end
    pcall(function()
        local cur = camera.CFrame
        -- отдача = камеру резко задрало ВВЕРХ за один кадр,
        -- позиция при этом почти на месте
        local dPos = (cur.Position - AR_SnapCF.Position).Magnitude
        local dUp = cur.LookVector.Y - AR_SnapCF.LookVector.Y
        if dPos < 1 and dUp > math.rad(AntiRecoil.Threshold) then
            camera.CFrame = CFrame.new(cur.Position) * AR_SnapCF.Rotation
        end
    end)
end)

