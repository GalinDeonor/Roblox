-- V4: панель собрана из «сырых» Roblox-инстансов внутри секции меню.
-- Все нажатия — через .Activated (честный тап: не срабатывает при
-- протаскивании пальца и одинаково работает на телефоне и на ПК).

local function normalizeName(raw)
    if type(raw) ~= "string" then
        return ""
    end
    local name = raw:gsub("^%s+", ""):gsub("%s+$", "")
    name = name:gsub("^@", "")
    return name
end

-- Ищет игрока по нику/DisplayName (без учёта регистра), иначе возвращает текст как есть
local function resolveName(raw)
    local name = normalizeName(raw)
    if name == "" then
        return nil
    end
    local lower = string.lower(name)
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.lower(plr.Name) == lower then
            return plr.Name
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.lower(plr.DisplayName) == lower then
            return plr.Name
        end
    end
    return name
end

