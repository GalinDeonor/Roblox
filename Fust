-- (пере)собирает список игроков; вызывается при входе/выходе игрока и после правок
local function rebuildPlayerList()
    clearPlayerRows()

    local rows = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(rows, plr)
        end
    end
    table.sort(rows, function(a, b)
        return a.Name < b.Name
    end)

    if #rows == 0 then
        local empty = Instance.new("TextLabel")
        empty.BackgroundTransparency = 1
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 12
        empty.TextColor3 = WL_GRAY
        empty.Text = "На сервере пока нет других игроков"
        empty.Size = UDim2.new(1, 0, 0, 26)
        empty.LayoutOrder = 1
        empty.Parent = wlScroll
        table.insert(wlRows, empty)
        return
    end

    for order, plr in ipairs(rows) do
        local row = Instance.new("TextButton")
        row.Name = "WL_" .. plr.Name
        row.AutoButtonColor = false
        row.Font = Enum.Font.Gotham
        row.TextSize = 13
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.BackgroundColor3 = WL_ROW
        row.BorderSizePixel = 0
        row.Size = UDim2.new(1, 0, 0, 30)
        row.LayoutOrder = order
        row:SetAttribute("WLText", plr.DisplayName .. " (@" .. plr.Name .. ")")
        row.Parent = wlScroll
        table.insert(wlRows, row)

        wlCorner(row, 5)

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 8)
        pad.Parent = row

        applyRowStyle(row, Whitelist[plr.Name] == true)

        -- Activated = честный тап: при листании списка НЕ срабатывает
        row.Activated:Connect(function()
            if Whitelist[plr.Name] then
                Whitelist[plr.Name] = nil
                applyRowStyle(row, false)
            else
                Whitelist[plr.Name] = true
                applyRowStyle(row, true)
            end
        end)
    end
end

