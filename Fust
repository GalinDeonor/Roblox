local espDrawings = {}
local hitboxOriginals = {}  -- player -> оригинальные параметры HumanoidRootPart
local ChamsCreateBlocked = false  -- V11: если игра блокирует Highlight — не спамим созданием

local function removeEspDrawings(plr)
    local ed = espDrawings[plr]
    if ed then
        for _, obj in pairs(ed) do
            pcall(function()
                obj:Remove()
            end)
        end
        espDrawings[plr] = nil
    end
end

local function ensureEspDrawings(plr)
    local ed = espDrawings[plr]
    if not ed then
        ed = {
            Box = Drawing.new("Square"),
            Name = Drawing.new("Text"),
            Distance = Drawing.new("Text"),
            Item = Drawing.new("Text"),
            HealthBarBg = Drawing.new("Line"),
            HealthBar = Drawing.new("Line"),
            HealthText = Drawing.new("Text"),
        }

        ed.Box.Filled = false
        ed.Box.Thickness = 1

        for _, key in ipairs({ "Name", "Distance", "HealthText", "Item" }) do
            ed[key].Center = true
            ed[key].Outline = true
            ed[key].Font = Drawing.Fonts.Plex
        end
        ed.Name.Size = 14
        ed.Distance.Size = 13
        ed.HealthText.Size = 11
        ed.HealthText.Center = false
        ed.Item.Size = 12

        ed.HealthBarBg.Thickness = 3
        ed.HealthBarBg.Color = Color3.fromRGB(0, 0, 0)
        ed.HealthBar.Thickness = 1.5

        espDrawings[plr] = ed
    end
    return ed
end

local function hideEspDrawings(ed)
    ed.Box.Visible = false
    ed.Name.Visible = false
    ed.Distance.Visible = false
    ed.Item.Visible = false
    ed.HealthBarBg.Visible = false
    ed.HealthBar.Visible = false
    ed.HealthText.Visible = false
end

-- Габарит персонажа в студах (ширина, высота, глубина)
local BOX_SIZE = Vector3.new(4, 6, 2.5)

-- Проецирует 8 углов 3D-габарита персонажа на экран.
-- Возвращает левый-верхний угол и размер в пикселях, либо nil,
-- если персонаж за камерой (тогда проекция зеркалится — рисовать нельзя).
-- ВАЖНО: глубину (перед камерой / за камерой) считаем сами через Dot —
-- у Delta WorldToViewportPoint возвращает мусорный Z на большой дистанции,
-- из-за чего ESP пропадал дальше ~300м. X/Y у проекции точные — их берём.
local function getScreenBox(camera, root)
    local camCF = camera.CFrame
    local camPos = camCF.Position
    local look = camCF.LookVector

    local cf = root.CFrame
    local hx, hy, hz = BOX_SIZE.X * 0.5, BOX_SIZE.Y * 0.5, BOX_SIZE.Z * 0.5

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge

    for i = 0, 7 do
        local ox = (i % 2 == 0) and -hx or hx
        local oy = (i % 4 < 2) and -hy or hy
        local oz = (i < 4) and -hz or hz

        local corner = (cf * CFrame.new(ox, oy, oz)).Position

        -- своя глубина: < 0 = точка за плоскостью камеры
        local depth = (corner - camPos):Dot(look)
        if depth <= 0.1 then
            return nil
        end

        local pt = camera:WorldToViewportPoint(corner)

        if pt.X < minX then minX = pt.X end
        if pt.X > maxX then maxX = pt.X end
        if pt.Y < minY then minY = pt.Y end
        if pt.Y > maxY then maxY = pt.Y end
    end

    return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY)
end

local renderConnection
renderConnection = RunService.RenderStepped:Connect(function()
    -- V11: защита от зомби-цикла — если запущен более новый скрипт,
    -- этот цикл отключает сам себя
    if getgenv().FUST_SESSION ~= FUST_SESSION then
        renderConnection:Disconnect()
        return
    end

    local Camera = Workspace.CurrentCamera
    if not Camera then
        return
    end

    if S.FullBright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    -- V12: анти-отдача слой 1 — CameraOffset (тычок камеры через гуманоида)
    if AntiRecoil.Enabled and myChar then
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if myHum and myHum.CameraOffset.Magnitude > 0 then
            myHum.CameraOffset = Vector3.new(0, 0, 0)
        end
    end

    local hitboxAppliedCount = 0  -- V11: сколько игроков реально расширено в этом кадре

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local isWhitelisted = Whitelist[player.Name] == true

            ---------------- Хитбоксы (V10) ----------------
            -- Работает на ЛЮБОЙ дистанции — больше НЕ зависит от
            -- слайдера «Max Distance» (из-за этой привязки хитбоксы
            -- молча отключались, если слайдер был сбит вниз).
            if root then
                -- запоминаем оригинальные параметры корня один раз,
                -- чтобы вернуть всё как было при выключении
                local orig = hitboxOriginals[player]
                if not orig or orig.Root ~= root then
                    orig = {
                        Root = root,
                        Size = root.Size,
                        Transparency = root.Transparency,
                        CanCollide = root.CanCollide,
                        CanQuery = root.CanQuery,
                    }
                    hitboxOriginals[player] = orig
                end

                local expanded = false
                if S.Hitbox.Enabled and myRoot and not isWhitelisted then
                    expanded = true
                    hitboxAppliedCount = hitboxAppliedCount + 1
                    local targetSize = Vector3.new(S.Hitbox.Size, S.Hitbox.Size, S.Hitbox.Size)
                    pcall(function()
                        if root.Size ~= targetSize then
                            root.Size = targetSize
                        end
                        root.Transparency = S.Hitbox.Transparency
                        root.CanCollide = false
                        root.CanQuery = true
                    end)
                end

                if not expanded then
                    pcall(function()
                        if root.Size ~= orig.Size then
                            root.Size = orig.Size
                        end
                        root.Transparency = orig.Transparency
                        root.CanCollide = orig.CanCollide
                        root.CanQuery = orig.CanQuery
                    end)
                end
            end

            ---------------- Chams (V11: pcall-защита) ----------------
            local highlight = char and char:FindFirstChild("VOMAGLA_Chams")
            if S.ESP.Enabled and S.ESP.Chams and char and root and myRoot then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist <= S.ESP.MaxDistance then
                    if not highlight and not ChamsCreateBlocked then
                        -- создание Highlight под pcall: если игра блокирует
                        -- инстанс, цикл кадра больше не умирает молча
                        local okH, created = pcall(function()
                            local h = Instance.new("Highlight")
                            h.Name = "VOMAGLA_Chams"
                            h.Adornee = char
                            h.Parent = char
                            return h
                        end)
                        if okH and created then
                            highlight = created
                        else
                            ChamsCreateBlocked = true
                            warn("[FUST] Highlight заблокирован игрой — чамсы отключены")
                        end
                    end

                    if highlight then
                        pcall(function()
                            highlight.FillColor = isWhitelisted and COLOR_WHITELIST or S.ESPColors.Box
                            local alpha = math.clamp(0.2 + (dist / S.ESP.MaxDistance) * 0.6, 0.2, 0.8)
                            highlight.FillTransparency = alpha
                            highlight.OutlineTransparency = alpha * 0.5
                            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            highlight.Enabled = true
                        end)
                    end
                elseif highlight then
                    pcall(function()
                        highlight.Enabled = false
                    end)
                end
            elseif highlight then
                pcall(function()
                    highlight.Enabled = false
                end)
            end

            ---------------- ESP ----------------
            if S.ESP.Enabled and char and root and myRoot and hum and hum.Health > 0 then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist <= S.ESP.MaxDistance then
                    local topLeft, boxSize = getScreenBox(Camera, root)

                    -- порог 1px: дальше ~1200м бокс уже 2-3px, но имя/дистанция должны жить
                    if topLeft and boxSize.X >= 1 and boxSize.Y >= 1 then
                        local ed = ensureEspDrawings(player)

                        local pad = 2
                        local bx = topLeft.X - pad
                        local by = topLeft.Y - pad
                        local bw = boxSize.X + pad * 2
                        local bh = boxSize.Y + pad * 2
                        local centerX = bx + bw * 0.5

                        if S.ESP.Box then
                            ed.Box.Position = Vector2.new(bx, by)
                            ed.Box.Size = Vector2.new(bw, bh)
                            ed.Box.Color = isWhitelisted and COLOR_WHITELIST or S.ESPColors.Box
                            ed.Box.Visible = true
                        else
                            ed.Box.Visible = false
                        end

                        if S.ESP.Name then
                            ed.Name.Text = player.Name
                            ed.Name.Position = Vector2.new(centerX, by - 18)
                            ed.Name.Color = isWhitelisted and COLOR_WHITELIST or COLOR_DEFAULT
                            ed.Name.Visible = true
                        else
                            ed.Name.Visible = false
                        end

                        if S.ESP.Distance then
                            ed.Distance.Text = math.floor(dist + 0.5) .. "m"
                            ed.Distance.Position = Vector2.new(centerX, by + bh + 4)
                            ed.Distance.Visible = true
                        else
                            ed.Distance.Visible = false
                        end

                        -- V12: предмет в руках (Tool, надетый на персонажа)
                        if S.ESP.Item then
                            local okTool, tool = pcall(function()
                                return char:FindFirstChildOfClass("Tool")
                            end)
                            if okTool and tool then
                                ed.Item.Text = tool.Name
                                ed.Item.Position = Vector2.new(centerX, by + bh + 23)
                                ed.Item.Color = isWhitelisted and COLOR_WHITELIST or Color3.fromRGB(255, 215, 90)
                                ed.Item.Visible = true
                            else
                                ed.Item.Visible = false
                            end
                        else
                            ed.Item.Visible = false
                        end

                        if S.ESP.HealthBar then
                            local maxHp = math.max(hum.MaxHealth, 1)
                            local pct = math.clamp(hum.Health / maxHp, 0, 1)
                            local barX = bx - 7

                            ed.HealthBarBg.From = Vector2.new(barX, by)
                            ed.HealthBarBg.To = Vector2.new(barX, by + bh)
                            ed.HealthBarBg.Visible = true

                            local fillTop = by + bh * (1 - pct)
                            ed.HealthBar.From = Vector2.new(barX, by + bh)
                            ed.HealthBar.To = Vector2.new(barX, fillTop)
                            ed.HealthBar.Color = Color3.fromRGB(
                                math.floor(255 - pct * 255),
                                math.floor(pct * 255),
                                0
                            )
                            ed.HealthBar.Visible = true

                            ed.HealthText.Text = tostring(math.floor(hum.Health + 0.5))
                            ed.HealthText.Position = Vector2.new(barX - 26, fillTop - 5)
                            ed.HealthText.Color = ed.HealthBar.Color
                            ed.HealthText.Visible = true
                        else
                            ed.HealthBarBg.Visible = false
                            ed.HealthBar.Visible = false
                            ed.HealthText.Visible = false
                        end
                    else
                        -- игрок за камерой / проекция невалидна — прячем
                        local ed = espDrawings[player]
                        if ed then
                            hideEspDrawings(ed)
                        end
                    end
                else
                    removeEspDrawings(player)
                end
            else
                removeEspDrawings(player)
            end
        end
    end

    -- V11: одноразовый отчёт — видно в консоли Delta, что цикл жив
    -- и хитбокс реально применяется
    if HitboxAnnouncePending then
        HitboxAnnouncePending = false
        print("[FUST] Хитбокс применён к " .. tostring(hitboxAppliedCount) .. " игрок(ам), размер " .. tostring(S.Hitbox.Size))
    end
end)

-- V11: полная очистка ЭТОГО запуска — вызывается при следующем execute.
-- Без неё прошлый цикл оставался зомби и ломал новый запуск.
getgenv().FUST_RenderCleanup = function()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end

    -- V12: отвязываем шаги анти-отдачи
    pcall(function()
        RunService:UnbindFromRenderStep("FUST_AR_Snap")
    end)
    pcall(function()
        RunService:UnbindFromRenderStep("FUST_AR_Restore")
    end)
    -- фильтр-хук сам отключится: он проверяет FUST_SESSION (метка запуска)

    -- возвращаем хитбоксы к оригиналам
    for _, orig in pairs(hitboxOriginals) do
        pcall(function()
            if orig.Root and orig.Root.Parent then
                orig.Root.Size = orig.Size
                orig.Root.Transparency = orig.Transparency
                orig.Root.CanCollide = orig.CanCollide
                orig.Root.CanQuery = orig.CanQuery
            end
        end)
    end

    -- убираем ESP-отрисовку этого запуска
    for plr in pairs(espDrawings) do
        pcall(removeEspDrawings, plr)
    end

    -- убираем чамсы этого запуска
    pcall(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            local c = plr.Character
            local hl = c and c:FindFirstChild("VOMAGLA_Chams")
            if hl then
                hl:Destroy()
            end
        end
    end)
end

