-- ============ АНТИ-ОТДАЧА (V12) ============
-- Отдача в Roblox-стрелялках делается одним из способов:
--   1) Humanoid.CameraOffset — «тычок» камеры через гуманоида;
--   2) отдельная запись Camera.CFrame с киком вверх (кик pitch);
--   3) поворот камеры после контроллера (BindToRenderStep после Camera).
-- Закрываем все три, каждый слой безопасен сам по себе.

local AntiRecoil = { Enabled = false, Threshold = 1.2 }
local ARSelfWrite = false   -- пишет камеру наш скрипт (аимбот/откат) — фильтр пропускает
local AR_LastWrite = nil    -- последняя камера-CFrame, виденная фильтром
local AR_LastTime = 0
local AR_Announced = false
local AR_SnapCF = nil       -- снапшот сразу после камеры — для отката в конце кадра
local ARHookInstalled = false

local function ensureAntiRecoilHook()
    if ARHookInstalled then
        return
    end
    ARHookInstalled = true

    if type(hookmetamethod) ~= "function" then
        warn("[FUST] Анти-отдача: hookmetamethod недоступен — работает только базовый режим")
        return
    end

    local oldNewIndex
    oldNewIndex = hookmetamethod(game, "__newindex", function(t, k, v)
        -- быстрые выходы: фильтр выключен / наш собственный кадр / не камера
        if not AntiRecoil.Enabled or getgenv().FUST_SESSION ~= FUST_SESSION then
            return oldNewIndex(t, k, v)
        end
        if ARSelfWrite or k ~= "CFrame" or t ~= Workspace.CurrentCamera then
            return oldNewIndex(t, k, v)
        end

        local now = os.clock()
        local prev = AR_LastWrite
        local gap = now - AR_LastTime
        AR_LastWrite = v
        AR_LastTime = now

        if type(v) ~= "CFrame" or type(prev) ~= "CFrame" or gap > 0.25 then
            return oldNewIndex(t, k, v)
        end

        -- кик = позиция почти не сдвинулась, но камера резко взмыла вверх
        local okFilter, fixed = pcall(function()
            local dPos = (v.Position - prev.Position).Magnitude
            local dPitch = v.LookVector.Y - prev.LookVector.Y
            if dPos < 0.25 and dPitch > math.rad(AntiRecoil.Threshold) then
                return CFrame.new(v.Position) * prev.Rotation
            end
            return nil
        end)

        if okFilter and fixed then
            if not AR_Announced then
                AR_Announced = true
                print("[FUST] Анти-отдача: фильтрую кик камеры")
            end
            AR_LastWrite = fixed
            return oldNewIndex(t, k, fixed)
        end

        return oldNewIndex(t, k, v)
    end)
end

-- снапшот сразу после контроллера камеры...
pcall(function()
    RunService:UnbindFromRenderStep("FUST_AR_Snap")
end)
pcall(function()
    RunService:UnbindFromRenderStep("FUST_AR_Restore")
end)

RunService:BindToRenderStep("FUST_AR_Snap", Enum.RenderPriority.Camera.Value + 1, function()
    if not AntiRecoil.Enabled then
        return
    end
    local camera = Workspace.CurrentCamera
    if camera then
        AR_SnapCF = camera.CFrame
    end
end)

-- ...и откат поворота в самом конце кадра (позиция остаётся текущей)
RunService:BindToRenderStep("FUST_AR_Restore", Enum.RenderPriority.Last.Value + 1, function()
    if not AntiRecoil.Enabled then
        return
    end
    local camera = Workspace.CurrentCamera
    if not (camera and AR_SnapCF) then
        return
    end
    pcall(function()
        local cur = camera.CFrame
        if (cur.LookVector - AR_SnapCF.LookVector).Magnitude > 1e-4 then
            ARSelfWrite = true
            camera.CFrame = CFrame.new(cur.Position) * AR_SnapCF.Rotation
            ARSelfWrite = false
        end
    end)
end)

