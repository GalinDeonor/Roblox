-- ================== ТРАССЕРЫ ПУЛЬ (V21, стиль VOMAGLA) ==================
-- Рендер взят из VOMAGLA: пул невидимых Parts с двумя Attachment и
-- Beam (FaceCamera, текстура трассера, LightEmission=1). У каждой
-- летящей пули один трассер — линия от точки выстрела до текущей
-- позиции пули, тянется за ней; пуля исчезла или застряла — линия
-- плавно тает. Части пула: CanQuery/CanTouch выключены, чтобы не
-- мешать рейкастам игры.
-- Детекция осталась своя (строгий детектор V20, БЕЗ hookmetamethod —
-- он дал бан в V12): мелкая часть, летящая быстро (40+ стад/с) и по
-- прямой два кадра подряд. Лут и обломки не рисуются.
-- ВАЖНО: Beam не рисуется сквозь стены — трассеры видны в прямой
-- видимости (в VOMAGLA они ведут себя так же).

local BULLET_COLOR_ENEMY = Color3.fromRGB(255, 60, 60)
local BULLET_COLOR_TEAM = Color3.fromRGB(255, 215, 0)
-- Стили луча — те же текстуры, что в VOMAGLA (Bullet Tracers → Texture)
local BULLET_TEXTURES = {
    ["Луч"] = "rbxassetid://12781852245",
    ["Молния"] = "rbxassetid://446111271",
    ["Сердцебиение"] = "rbxassetid://5830549480",
    ["Цепь"] = "rbxassetid://9632168658",
    ["Глитч"] = "rbxassetid://8089467613",
    ["Вихрь"] = "rbxassetid://5638168605",
}

local bulletTracks = {}   -- кандидаты и живые трассеры
local bulletConn = nil
local bulletOn = false

-- 0.26: пул Beam-частей ДВУХ ВИДОВ:
--   "ribbon" — классическая лента VOMAGLA (одна Beam между A0/A1);
--   "square" — объёмный КВАДРАТНЫЙ трассер: 4 ребра-Beam по углам
--              квадратного сечения + яркое ядро по центру. Сечение
--              перпендикулярно полёту пули — труба выглядит объёмной.
-- Часть переиспользуется, Beam настроены один раз при создании.
local bulletPool = {}      -- { {Part = part, Kind = kind}, ... }
local bulletPoolSize = 0

local function bulletPoolGet(kind)
    if bulletPoolSize > 0 then
        for i = bulletPoolSize, 1, -1 do
            local item = bulletPool[i]
            if item and item.Kind == kind then
                bulletPool[i] = bulletPool[bulletPoolSize]
                bulletPool[bulletPoolSize] = nil
                bulletPoolSize = bulletPoolSize - 1
                return item.Part
            end
        end
    end

    local okP, p = pcall(function()
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.CastShadow = false
        part.Transparency = 1
        part.Size = Vector3.new(0.1, 0.1, 0.1)

        if kind == "square" then
            -- КВАДРАТНЫЙ: ядро (C0/C1) + 4 ребра по углам (E1..E4)
            local c0 = Instance.new("Attachment")
            c0.Name = "C0"
            c0.Parent = part
            local c1 = Instance.new("Attachment")
            c1.Name = "C1"
            c1.Parent = part

            local core = Instance.new("Beam")
            core.Name = "Core"
            core.Attachment0 = c0
            core.Attachment1 = c1
            core.FaceCamera = true
            core.LightEmission = 1
            core.LightInfluence = 0
            core.Enabled = false
            core.Parent = part

            for idx, corner in ipairs({ { 1, 1 }, { -1, 1 }, { -1, -1 }, { 1, -1 } }) do
                local a0 = Instance.new("Attachment")
                a0.Name = "E" .. idx .. "A"
                a0.Parent = part
                local a1 = Instance.new("Attachment")
                a1.Name = "E" .. idx .. "B"
                a1.Parent = part

                local b = Instance.new("Beam")
                b.Name = "E" .. idx
                b.Attachment0 = a0
                b.Attachment1 = a1
                b.FaceCamera = false
                b.LightEmission = 1
                b.LightInfluence = 0
                b.Enabled = false
                b.Parent = part
            end

            part:SetAttribute("PetuhKind", "square")
            return part
        end

        -- классическая лента (стиль VOMAGLA)
        local a0 = Instance.new("Attachment")
        a0.Name = "A0"
        a0.Parent = part
        local a1 = Instance.new("Attachment")
        a1.Name = "A1"
        a1.Parent = part
        local b = Instance.new("Beam")
        b.Name = "B"
        b.Attachment0 = a0
        b.Attachment1 = a1
        b.FaceCamera = true
        b.LightEmission = 1
        b.LightInfluence = 0
        b.TextureLength = 2
        b.TextureSpeed = 2
        b.Enabled = false
        b.Parent = part
        part:SetAttribute("PetuhKind", "ribbon")
        return part
    end)
    if okP then
        return p
    end
    return nil
end

local function bulletPoolRelease(p, kind)
    if p then
        pcall(function()
            p.Parent = nil
        end)
        bulletPoolSize = bulletPoolSize + 1
        bulletPool[bulletPoolSize] = {
            Part = p,
            Kind = kind or p:GetAttribute("PetuhKind") or "ribbon",
        }
    end
end

-- полное уничтожение пула (при выгрузке скрипта)
local function bulletPoolDestroy()
    for i = 1, bulletPoolSize do
        local item = bulletPool[i]
        if item and item.Part then
            pcall(function()
                item.Part:Destroy()
            end)
        end
    end
    bulletPool = {}
    bulletPoolSize = 0
end

-- 0.26: надевает на трассер деталь нужного вида (лента или квадрат)
-- и собирает ссылки на Beam/Attachment'ы. false — если экзекутор не
-- дал создать (тогда трассер просто не рисуется).
local function setupTracerPart(t, square)
    local kind = square and "square" or "ribbon"
    local newPart = bulletPoolGet(kind)
    if not newPart then
        return false
    end

    local refsOk = true
    local core = nil
    local edges = {}
    local signs = { { 1, 1 }, { -1, 1 }, { -1, -1 }, { 1, -1 } }

    if square then
        core = newPart:FindFirstChild("Core")
        if not core then
            refsOk = false
        end
        for idx = 1, 4 do
            local b = newPart:FindFirstChild("E" .. idx)
            local a0 = newPart:FindFirstChild("E" .. idx .. "A")
            local a1 = newPart:FindFirstChild("E" .. idx .. "B")
            if not (b and a0 and a1) then
                refsOk = false
            else
                edges[idx] = { Beam = b, A0 = a0, A1 = a1 }
            end
        end
    else
        local b = newPart:FindFirstChild("B")
        local a0 = newPart:FindFirstChild("A0")
        local a1 = newPart:FindFirstChild("A1")
        if not (b and a0 and a1) then
            refsOk = false
        else
            t.Beam = b
            t.A0 = a0
            t.A1 = a1
        end
    end

    if not refsOk then
        pcall(function()
            newPart:Destroy()
        end)
        return false
    end

    t.BeamPart = newPart
    t.Kind = kind
    if square then
        t.Sq = { Core = core, Edges = edges, Signs = signs }
    end
    newPart.Parent = Workspace
    return true
end

-- ищем создателя пули: ObjectValue-тег или атрибут Player/Creator/Owner
local function resolveBulletCreator(inst)
    local okC, creator = pcall(function()
        for _, ch in ipairs(inst:GetChildren()) do
            if ch:IsA("ObjectValue") then
                local v = ch.Value
                if typeof(v) == "Instance" and v:IsA("Player") then
                    return v
                end
            end
        end
        for _, attr in ipairs({ "Player", "Creator", "Owner", "Plr" }) do
            local a = inst:GetAttribute(attr)
            if a ~= nil then
                if typeof(a) == "Instance" and a:IsA("Player") then
                    return a
                elseif type(a) == "string" then
                    return Players:FindFirstChild(a)
                end
            end
        end
        return nil
    end)
    if okC then
        return creator
    end
    return nil
end

local function clearBulletDrawings()
    for _, t in ipairs(bulletTracks) do
        if t.BeamPart then
            if t.Beam then
                pcall(function()
                    t.Beam.Enabled = false
                end)
            end
            if t.Sq then
                for _, e in ipairs(t.Sq.Edges) do
                    pcall(function()
                        e.Beam.Enabled = false
                    end)
                end
                pcall(function()
                    t.Sq.Core.Enabled = false
                end)
            end
            bulletPoolRelease(t.BeamPart, t.Kind)
        end
    end
    bulletTracks = {}
end

-- кандидат в пули: мелкая часть не внутри персонажа. «Пуля или лут»
-- решает детектор движения в updateBullets — здесь только грубый фильтр,
-- чтобы не копить мусор.
local function onNewWorldPart(inst)
    if #bulletTracks > 40 then
        return
    end
    local okTrack, isPart = pcall(function()
        if not inst:IsA("BasePart") then
            return false
        end
        local sz = inst.Size
        if math.max(sz.X, sz.Y, sz.Z) > 2.5 then
            return false
        end
        local model = inst:FindFirstAncestorOfClass("Model")
        while model do
            if model:FindFirstChildOfClass("Humanoid") then
                return false
            end
            model = model:FindFirstAncestorOfClass("Model")
        end
        return true
    end)
    if okTrack and isPart then
        table.insert(bulletTracks, {
            Part = inst,
            Born = os.clock(),
            Pos = inst.Position,
            LastTime = os.clock(),
            LastMoveAt = os.clock(),
            Straight = 0,
            LastDir = nil,
            Promoted = false,
            Origin = nil,
            BeamPart = nil,
            Beam = nil,
            A0 = nil,
            A1 = nil,
            Died = nil,
            IsTeam = false,
        })
    end
end

-- полное включение/выключение. Выключено — слушателя НЕТ вообще: новые
-- «пули» не ловятся, все трассеры убраны. Тумблер не может «не выключить».
local function setBulletsEnabled(on)
    on = on and true or false
    if on == bulletOn then
        return
    end
    bulletOn = on
    if bulletConn then
        pcall(function()
            bulletConn:Disconnect()
        end)
        bulletConn = nil
    end
    clearBulletDrawings()
    if on then
        bulletConn = Workspace.DescendantAdded:Connect(onNewWorldPart)
    end
end
FUST_BulletsSet = setBulletsEnabled

-- вызывается каждый кадр из главного рендер-цикла (камера не нужна:
-- Beam — мировой объект, не Drawing)
local function updateBullets()
    local now = os.clock()

    -- страховка: выключено — тихо прибираем за собой (один раз)
    if not bulletOn then
        if #bulletTracks > 0 then
            clearBulletDrawings()
        end
        return
    end

    local width = math.clamp(S.Bullets.Width or 1.5, 0.1, 5)
    local baseT = math.clamp(S.Bullets.Transparency or 0, 0, 0.95)
    local texture = BULLET_TEXTURES[S.Bullets.Style or "Луч"] or BULLET_TEXTURES["Луч"]

    for i = #bulletTracks, 1, -1 do
        local t = bulletTracks[i]
        local part = t.Part

        if part.Parent then
            local pos = part.Position
            local dt = now - t.LastTime
            t.LastTime = now

            if not t.Promoted then
                -- детектор: пуля летит БЫСТРО и ПО ПРЯМОЙ два кадра подряд.
                -- Лут и обломки либо медленные, либо кувыркаются — до
                -- трассера они не доживают.
                local seg = pos - t.Pos
                local dist = seg.Magnitude
                if dt > 0 and dist > 0.001 then
                    local sp = dist / dt
                    if sp > 40 then
                        local dir = seg.Unit
                        if not t.LastDir or dir:Dot(t.LastDir) > 0.75 then
                            t.Straight = t.Straight + 1
                        else
                            t.Straight = 0
                        end
                        t.LastDir = dir
                    else
                        t.Straight = 0
                        t.LastDir = nil
                    end
                end

                if t.Straight >= 2 then
                    -- хватит данных: свои пули не рисуем, чужие — трассерим.
                    -- Origin чуть назад по траектории — линия «выходит» из дула.
                    local cr = resolveBulletCreator(part)
                    if cr == LocalPlayer then
                        table.remove(bulletTracks, i)
                    else
                        t.Promoted = true
                        t.IsTeam = cr ~= nil and cr.Team ~= nil and cr.Team == LocalPlayer.Team
                        t.Origin = pos - seg.Unit * dist * 2
                        -- 0.26: вид трассера — лента (как было) или «Квадратный»
                        if not setupTracerPart(t, (S.Bullets.Style or "Луч") == "Квадратный") then
                            table.remove(bulletTracks, i)
                        end
                    end
                elseif now - t.Born > 1 then
                    -- так и не полетела (лут/эффект) — выбрасываем
                    table.remove(bulletTracks, i)
                end
            else
                -- пуля ещё летит? если не двигалась 0.35с — полёт кончился
                if (pos - t.Pos).Magnitude > 0.02 then
                    t.LastMoveAt = now
                end
            end

            t.Pos = pos
        elseif not t.Promoted then
            -- исчезла, так и не полетев — мусор, убираем
            table.remove(bulletTracks, i)
        else
            -- летящая пуля исчезла из мира — трассер замирает и тает
            if not t.Died then
                t.Died = now
            end
        end

        -- застрявшая пуля (стрела в стене) — полёт кончился, линия тает
        if t.Promoted and not t.Died and now - (t.LastMoveAt or t.Born) > 0.35 then
            t.Died = now
        end

        -- 0.26: вид сменили в меню на лету — пересобираем деталь трассера
        if t.Promoted then
            local wantSquare = (S.Bullets.Style or "Луч") == "Квадратный"
            if (t.Kind == "square") ~= wantSquare then
                if t.BeamPart then
                    pcall(function()
                        if t.Beam then
                            t.Beam.Enabled = false
                        end
                        if t.Sq then
                            for _, e in ipairs(t.Sq.Edges) do
                                e.Beam.Enabled = false
                            end
                            t.Sq.Core.Enabled = false
                        end
                    end)
                    bulletPoolRelease(t.BeamPart, t.Kind)
                end
                t.BeamPart = nil
                t.Beam = nil
                t.A0 = nil
                t.A1 = nil
                t.Sq = nil
                if not setupTracerPart(t, wantSquare) then
                    table.remove(bulletTracks, i)
                end
            end
        end

        -- отрисовка (живые и тающие трассеры)
        if t.Promoted and t.BeamPart then
            local fade = math.max(S.Bullets.Fade or 1, 0.05)
            local age = t.Died and (now - t.Died) or 0
            if age > fade then
                pcall(function()
                    if t.Beam then
                        t.Beam.Enabled = false
                    end
                    if t.Sq then
                        for _, e in ipairs(t.Sq.Edges) do
                            e.Beam.Enabled = false
                        end
                        t.Sq.Core.Enabled = false
                    end
                end)
                bulletPoolRelease(t.BeamPart, t.Kind)
                t.BeamPart = nil
                t.Beam = nil
                t.A0 = nil
                t.A1 = nil
                t.Sq = nil
                table.remove(bulletTracks, i)
            elseif t.Kind == "square" and t.Sq then
                -- 0.26: КВАДРАТНЫЙ трассер — объёмная квадратная «труба»:
                -- 4 ребра по углам сечения (перпендикулярно полёту пули)
                -- плюс яркое ядро. Крупнее полоски, чётко читается в бою.
                pcall(function()
                    local segV = t.Pos - t.Origin
                    if segV.Magnitude > 0.01 then
                        -- строго вертикальный полёт: lookAt вырождается,
                        -- подменяем опорную ось
                        local upVec = (math.abs(segV.Unit.Y) > 0.99) and Vector3.zAxis or Vector3.yAxis
                        t.BeamPart.CFrame = CFrame.lookAt(t.Origin, t.Pos, upVec)
                    end

                    local half = math.clamp(width, 0.5, 5) * 0.75
                    local edgeW = math.clamp(width * 0.1, 0.06, 0.3)
                    local color = ColorSequence.new(t.IsTeam and BULLET_COLOR_TEAM or BULLET_COLOR_ENEMY)
                    local alpha = t.Died and (baseT + (1 - baseT) * math.clamp(age / fade, 0, 1)) or baseT
                    local seq = NumberSequence.new(alpha)

                    for idx, edge in ipairs(t.Sq.Edges) do
                        local off = Vector3.new(t.Sq.Signs[idx][1] * half, t.Sq.Signs[idx][2] * half, 0)
                        edge.A0.Position = off
                        edge.A1.Position = off
                        edge.Beam.Color = color
                        edge.Beam.Transparency = seq
                        edge.Beam.Width0 = edgeW
                        edge.Beam.Width1 = edgeW
                        edge.Beam.Enabled = true
                    end

                    t.Sq.Core.Color = color
                    t.Sq.Core.Transparency = seq
                    t.Sq.Core.Width0 = math.max(width * 0.35, 0.08)
                    t.Sq.Core.Width1 = math.max(width * 0.35, 0.08)
                    t.Sq.Core.Enabled = true
                end)
            elseif t.Beam then
                pcall(function()
                    if t.A0 then
                        t.A0.WorldPosition = t.Origin
                    end
                    if t.A1 then
                        t.A1.WorldPosition = t.Pos
                    end
                    t.Beam.Color = ColorSequence.new(t.IsTeam and BULLET_COLOR_TEAM or BULLET_COLOR_ENEMY)
                    if t.Died then
                        local progress = math.clamp(age / fade, 0, 1)
                        t.Beam.Transparency = NumberSequence.new(baseT + (1 - baseT) * progress)
                    else
                        t.Beam.Transparency = NumberSequence.new(baseT)
                    end
                    t.Beam.Width0 = width
                    t.Beam.Width1 = width
                    t.Beam.Texture = texture
                end)
            end
        end
    end
end

local function removeEspDrawings(plr)
    local ed = espDrawings[plr]
    if ed then
        for _, obj in pairs(ed) do
