local CH_GAP, CH_LEN = 5, 7
local chLines = {}
for i = 1, 4 do
    local l = Drawing.new("Line")
    l.Thickness = 2
    l.Color = Color3.fromRGB(255, 30, 30)
    l.Visible = false
    chLines[i] = l
end

local function updateCrosshair(center, visible)
    chLines[1].From = Vector2.new(center.X, center.Y - CH_GAP)
    chLines[1].To = Vector2.new(center.X, center.Y - CH_GAP - CH_LEN)
    chLines[2].From = Vector2.new(center.X, center.Y + CH_GAP)
    chLines[2].To = Vector2.new(center.X, center.Y + CH_GAP + CH_LEN)
    chLines[3].From = Vector2.new(center.X - CH_GAP, center.Y)
    chLines[3].To = Vector2.new(center.X - CH_GAP - CH_LEN, center.Y)
    chLines[4].From = Vector2.new(center.X + CH_GAP, center.Y)
    chLines[4].To = Vector2.new(center.X + CH_GAP + CH_LEN, center.Y)
    for i = 1, 4 do
        chLines[i].Visible = visible
    end
end

-- ---- Поиск цели ----
local aimRayParams = RaycastParams.new()
aimRayParams.FilterType = Enum.RaycastFilterType.Exclude
aimRayParams.IgnoreWater = true

local function resolveAimPart(character, choice)
    local pick = choice
    if pick == "Random" then
        pick = AIM_PARTS[math.random(1, 3)]
    end
    if pick == "Head" then
        return character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso")
    elseif pick == "Torso" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
    elseif pick == "Legs" then
        return character:FindFirstChild("LeftLeg")
            or character:FindFirstChild("RightLeg")
            or character:FindFirstChild("LeftFoot")
            or character:FindFirstChild("RightFoot")
    end
    return character:FindFirstChild("HumanoidRootPart")
end

-- Луч от камеры до точки прицеливания: исключаем своего и чужого персонажа,
-- поэтому ЛЮБОЙ.hit = стена/препятствие
local function wallBetween(fromPos, targetChar, targetPos)
    local filter = {}
    if LocalPlayer.Character then
        table.insert(filter, LocalPlayer.Character)
    end
    table.insert(filter, targetChar)
    aimRayParams.FilterDescendantsInstances = filter
    return Workspace:Raycast(fromPos, targetPos - fromPos, aimRayParams) ~= nil
end

-- Возвращает part и точку наведения (уже с предиктом)
local function getAimTarget(camera)
    local char = LocalPlayer.Character
    local localRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not localRoot then
        return nil
    end

    local camPos = camera.CFrame.Position
    local look = camera.CFrame.LookVector
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    local bestPart, bestPoint
    local bestScore = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer
            and Whitelist[plr.Name] == nil
            and not (Aim.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team) then

            local model = plr.Character
            local hum = model and model:FindFirstChildOfClass("Humanoid")
            local root = model and model:FindFirstChild("HumanoidRootPart")

            if hum and root and hum.Health > 0 then
                local worldDist = (root.Position - localRoot.Position).Magnitude
                if worldDist <= Aim.Distance then
                    local part = resolveAimPart(model, Aim.Part)
                    if part then
                        -- Предикт: упреждение по скорости корня (включая транспорт)
                        local vel = root.AssemblyLinearVelocity
                        local aimPos = part.Position + vel * Aim.Prediction

                        -- Глубина через Dot: WorldToViewportPoint на Delta врёт по Z
                        local toPoint = aimPos - camPos
                        if toPoint:Dot(look) > 0 then
                            local sp = camera:WorldToViewportPoint(aimPos)
                            local screenDist = (center - Vector2.new(sp.X, sp.Y)).Magnitude

                            if screenDist <= Aim.FOV then
                                if not Aim.WallCheck or not wallBetween(camPos, model, aimPos) then
                                    local score = (Aim.Priority == "Дистанция") and worldDist or screenDist
                                    if score < bestScore then
                                        bestScore = score
                                        bestPart = part
                                        bestPoint = aimPos
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bestPart, bestPoint
end

