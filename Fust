-- ==================== КОНФИГИ (СОХРАНЕНИЕ / ЗАГРУЗКА) ===================
-- V6: свой конфиг через writefile/readfile — надёжнее встроенных конфигов
-- Avilon на Delta. Сохраняется всё: ESP, цвет бокса, визуалы, хитбокс,
-- аимбот (включая парт/приоритет) и вайтлист. Файл: FUST_config.json.

local HttpService = game:GetService("HttpService")
local CONFIG_FILE = "FUST_config.json"

local function colorToTable(c)
    return {
        R = math.floor(c.R * 255 + 0.5),
        G = math.floor(c.G * 255 + 0.5),
        B = math.floor(c.B * 255 + 0.5),
    }
end

local function tableToColor(t)
    if type(t) ~= "table" then
        return nil
    end
    return Color3.fromRGB(tonumber(t.R) or 0, tonumber(t.G) or 0, tonumber(t.B) or 0)
end

local function saveConfig()
    local okFile, err = pcall(function()
        local wl = {}
        for name in pairs(Whitelist) do
            table.insert(wl, name)
        end
        table.sort(wl)

        local cfg = {
            ESP = {
                Enabled = S.ESP.Enabled,
                Box = S.ESP.Box,
                Chams = S.ESP.Chams,
                Item = S.ESP.Item,
                Name = S.ESP.Name,
                Distance = S.ESP.Distance,
                HealthBar = S.ESP.HealthBar,
                MaxDistance = S.ESP.MaxDistance,
            },
            BoxColor = colorToTable(S.ESPColors.Box),
            Hitbox = {
                Enabled = S.Hitbox.Enabled,
                Size = S.Hitbox.Size,
                Transparency = S.Hitbox.Transparency,
            },
            FullBright = S.FullBright,
            NoDecoration = S.NoDecoration,
            NoGrass = S.NoGrass,
            Aim = {
                Enabled = Aim.Enabled,
                ShowFOV = Aim.ShowFOV,
                FOV = Aim.FOV,
                Distance = Aim.Distance,
                Smooth = Aim.Smooth,
                Prediction = Aim.Prediction,
                Part = Aim.Part,
                Priority = Aim.Priority,
                WallCheck = Aim.WallCheck,
                TeamCheck = Aim.TeamCheck,
                Crosshair = Aim.Crosshair,
            },
            AntiRecoil = {
                Enabled = AntiRecoil.Enabled,
                Threshold = AntiRecoil.Threshold,
            },
            Whitelist = wl,
        }
        writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
    end)
    return okFile, err
end

-- Применяет значение к тумблеру/слайдеру через Set: обновится и картинка
-- в меню, и состояние, и колбэк (Set у Avilon дергает Callback)
local function applyFlag(key, value)
    local obj = UIRegistry[key]
    if obj and value ~= nil and obj.Set then
        pcall(function()
            obj:Set(value)
        end)
    end
end

local function loadConfig()
    if type(isfile) ~= "function" or not isfile(CONFIG_FILE) then
        return false, "конфиг ещё не сохранялся"
    end

    local okFile, err = pcall(function()
        local cfg = HttpService:JSONDecode(readfile(CONFIG_FILE))

        if type(cfg.ESP) == "table" then
            applyFlag("ESPEnabled", cfg.ESP.Enabled)
            applyFlag("ESPBox", cfg.ESP.Box)
            applyFlag("ESPChams", cfg.ESP.Chams)
            applyFlag("ESPItem", cfg.ESP.Item)
            applyFlag("ESPName", cfg.ESP.Name)
            applyFlag("ESPDistance", cfg.ESP.Distance)
            applyFlag("ESPHealthBar", cfg.ESP.HealthBar)
            applyFlag("ESPMaxDistance", cfg.ESP.MaxDistance)
        end

        local boxColor = tableToColor(cfg.BoxColor)
        if boxColor then
            S.ESPColors.Box = boxColor
            if UIRegistry.ESPBoxColor and UIRegistry.ESPBoxColor.Set then
                pcall(function()
                    UIRegistry.ESPBoxColor:Set(boxColor)
                end)
            end
        end

        if type(cfg.Hitbox) == "table" then
            applyFlag("HitboxEnabled", cfg.Hitbox.Enabled)
            applyFlag("HitboxSize", cfg.Hitbox.Size)
            if cfg.Hitbox.Transparency then
                S.Hitbox.Transparency = tonumber(cfg.Hitbox.Transparency) or S.Hitbox.Transparency
            end
        end

        applyFlag("FullBright", cfg.FullBright)
        applyFlag("NoDecoration", cfg.NoDecoration)
        applyFlag("NoGrass", cfg.NoGrass)

        if type(cfg.AntiRecoil) == "table" then
            applyFlag("AntiRecoilEnabled", cfg.AntiRecoil.Enabled)
            applyFlag("AntiRecoilThreshold", cfg.AntiRecoil.Threshold)
        end

        if type(cfg.Aim) == "table" then
            local a = cfg.Aim
            applyFlag("AimEnabled", a.Enabled)
            applyFlag("AimShowFOV", a.ShowFOV)
            applyFlag("AimFOV", a.FOV)
            applyFlag("AimDistance", a.Distance)
            applyFlag("AimSmooth", a.Smooth)
            applyFlag("AimPrediction", a.Prediction)
            applyFlag("AimWallCheck", a.WallCheck)
            applyFlag("AimTeamCheck", a.TeamCheck)
            applyFlag("AimCrosshair", a.Crosshair)

            if a.Part and table.find(AIM_PARTS, a.Part) then
                Aim.Part = a.Part
                aimPartIndex = table.find(AIM_PARTS, a.Part) or 1
                aimPartButton.Text = "Аим парт: " .. AIM_PART_NAMES[Aim.Part]
            end
            if a.Priority == "Прицел" or a.Priority == "Дистанция" then
                Aim.Priority = a.Priority
                aimPriorityButton.Text = "Приоритет: " .. string.upper(Aim.Priority)
            end
        end

        if type(cfg.Whitelist) == "table" then
            table.clear(Whitelist)
            for _, name in ipairs(cfg.Whitelist) do
                if type(name) == "string" then
                    Whitelist[name] = true
                end
            end
            rebuildPlayerList()
        end
    end)
    return okFile, err
end

