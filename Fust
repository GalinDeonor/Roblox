local aimRayParams = RaycastParams.new()
aimRayParams.FilterType = Enum.RaycastFilterType.Exclude
aimRayParams.IgnoreWater = true

local function resolveAimPart(character, choice)
    local pick = choice
    if pick == "Random" then
        pick = AIM_PARTS[math.random(1, 3)]
    end
    if pick == "Head" then
        return character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso")
    elseif pick == "Torso" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
    elseif pick == "Legs" then
        return character:FindFirstChild("LeftLeg")
            or character:FindFirstChild("RightLeg")
            or character:FindFirstChild("LeftFoot")
            or character:FindFirstChild("RightFoot")
    end
    return character:FindFirstChild("HumanoidRootPart")
end

-- Луч от камеры до точки прицеливания: исключаем своего и чужого персонажа,
-- поэтому ЛЮБОЙ.hit = стена/препятствие
local function wallBetween(fromPos, targetChar, targetPos)
    local filter = {}
    if LocalPlayer.Character then
        table.insert(filter, LocalPlayer.Character)
    end
    table.insert(filter, targetChar)
    aimRayParams.FilterDescendantsInstances = filter
    return Workspace:Raycast(fromPos, targetPos - fromPos, aimRayParams) ~= nil
end

-- ============ 0.26: ТРЕКЕР БОТОВ И НПС ============
-- Боты и НПС — модели Workspace с Humanoid, которые не принадлежат
-- игрокам. Собираем их в trackedNPCs: скан раз в секунду (отдельный
-- поток, рендер не грузим) + мгновенная ловля новых моделей через
-- DescendantAdded. Только ЧТЕНИЕ мира — ничего не пишем и не перехва-
-- тываем, бан-риска как у ESP.
local trackedNPCs = {}   -- [Model] = true
local NPC_LastCount = 0  -- сколько НПС отслежено (диагностика)

local function npcFeaturesActive()
    return (S.NPC.ESP or S.NPC.Chams or S.NPC.HitboxEnabled
        or (Aim.Enabled and (Aim.TargetsNPC or Aim.TargetsAnimals or Aim.TargetsSleepers)))
        and true or false
end

local function isPlayerCharacter(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then
            return true
        end
    end
    return false
end

local function tryTrackNPC(model)
    if not model or not model:IsA("Model") or trackedNPCs[model] then
        return
    end

    local okN, hum = pcall(function()
        return model:FindFirstChildOfClass("Humanoid")
    end)
    if not okN or not hum then
        return
    end

    local okR, root = pcall(function()
        return model:FindFirstChild("HumanoidRootPart")
    end)
    if not okR or not root then
        return
    end

    if isPlayerCharacter(model) then
        return
    end

    trackedNPCs[model] = true
end

local function scanNPCContainer(container, depth)
    local okS, children = pcall(function()
        return container:GetChildren()
    end)
    if not okS or not children then
        return
    end
    for _, inst in ipairs(children) do
        if inst:IsA("Model") then
            tryTrackNPC(inst)
        elseif depth > 0 and (inst:IsA("Folder") or inst:IsA("WorldModel")) then
            scanNPCContainer(inst, depth - 1)
        end
    end
end

-- фоновый скан: раз в секунду и только когда нужна хотя бы одна
-- бот-функция; при перезапуске скрипта поток сам умирает (сессия)
task.spawn(function()
    while getgenv().FUST_SESSION == FUST_SESSION do
        if npcFeaturesActive() then
            pcall(function()
                for model in pairs(trackedNPCs) do
                    if not model.Parent or not model:IsDescendantOf(Workspace) then
                        trackedNPCs[model] = nil
                    end
                end
                scanNPCContainer(Workspace, 2)
                -- 0.27: НПС/животные по тегам игры — могут лежать вне папок
                for _, npcTag in ipairs({ "FustNpc", "FustAnimal", "FustDino" }) do
                    local okTags, tagged = pcall(CollectionService.GetTagged, CollectionService, npcTag)
                    if okTags and tagged then
                        for _, taggedModel in ipairs(tagged) do
                            tryTrackNPC(taggedModel)
                        end
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

-- новые модели ловим сразу; Humanoid мог ещё не доехать до модельки —
-- секундный скан доберёт пропущенное
pcall(function()
    Library:Connect(Workspace.DescendantAdded, function(inst)
        if npcFeaturesActive() and inst:IsA("Model") then
            task.defer(tryTrackNPC, inst)
