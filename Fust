-- УНИВЕРСАЛЬНОСТЬ: если в экзекуторе нет Drawing-библиотеки, ставим
-- заглушки — скрипт продолжит работать (без оверлеев), а не упадёт.
if type(Drawing) ~= "table" and type(Drawing) ~= "userdata" then
    local function makeDummyDrawing()
        local dummy = {}
        dummy.Visible = false
        dummy.Color = Color3.new(1, 1, 1)
        dummy.Thickness = 0
        dummy.Filled = false
        dummy.Radius = 0
        dummy.NumSides = 3
        dummy.Text = ""
        dummy.Size = 0
        dummy.Center = false
        dummy.Outline = false
        dummy.Font = 0
        dummy.From = Vector2.new(0, 0)
        dummy.To = Vector2.new(0, 0)
        dummy.Position = Vector2.new(0, 0)
        dummy.Transparency = 1
        function dummy:Remove() end
        return dummy
    end
    Drawing = { new = function() return makeDummyDrawing() end, Fonts = { Plex = 0 } }
    warn("[FUST] Drawing недоступен в этом экзекуторе — ESP/прицел работают вхолостую")
end

local AIM_FOV_OFF = Color3.fromRGB(150, 0, 20)
local AIM_FOV_ON = Color3.fromRGB(0, 255, 100)

