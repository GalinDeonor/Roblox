-- V11: разовая зачистка мира от следов зомби-циклов СТАРЫХ версий:
-- корень-«куб» (X==Y==Z, >=3) — сигнатура нашего расширителя,
-- возвращаем к стандартным 2х2х1; левые чамсы уничтожаем.
pcall(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        local c = plr.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if root then
            local s = root.Size
            if s.X == s.Y and s.Y == s.Z and s.X >= 3 then
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
                root.CanCollide = true
                root.CanQuery = true
            end
        end
        local hl = c and c:FindFirstChild("VOMAGLA_Chams")
        if hl then
            hl:Destroy()
        end
        local rhl = root and root:FindFirstChild("VOMAGLA_HitboxChams")
        if rhl then
            rhl:Destroy()
        end
    end
end)

-- ============ ЖУРНАЛ ДЛЯ ДИАГНОСТИКИ БАНОВ (V14) ============
-- «Лазейка», чтобы понять, ЗА ЧТО забанили: каждое включение/выключение
-- фичи и снимок состояния раз в минуту пишутся в консоль И в файл
-- FUST_journal.txt (лежит в папке scripts у Delta, рядом с конфигом).
-- Словил бан → открой журнал: последние строки перед обрывом показывают,
-- что было включено в момент бана. Ориентир по риску: аимбот и хитбокс —
-- ВЫСОКИЙ, анти-отдача — СРЕДНИЙ, чамсы/ESP/визуалы — НИЗКИЙ.
local JOURNAL_FILE = "FUST_journal.txt"

-- журнал не должен расти бесконечно: больше 256 КБ — начинаем заново
pcall(function()
    if type(isfile) == "function" and isfile(JOURNAL_FILE) then
        if #readfile(JOURNAL_FILE) > 262144 then
            writefile(JOURNAL_FILE, "")
        end
    end
end)

local function journal(msg)
    local okDate, stamp = pcall(os.date, "%d.%m %H:%M:%S")
    if okDate and stamp then
        stamp = stamp .. " "
    else
        stamp = ""
    end
    print("[FUST-J] " .. stamp .. msg)
    if type(appendfile) == "function" then
        pcall(function()
            appendfile(JOURNAL_FILE, stamp .. msg .. "\n")
        end)
    end
end

