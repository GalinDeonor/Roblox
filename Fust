-- 0.25: ОКОННЫЙ РЕЖИМ + КНОПКА ФУЛЛСКРИНА + фикс «окно за экраном».
-- Раньше окно было всегда 900x600, позиция фиксировалась ДО подгонки
-- размера, а минимум ресайза был 900x600 — на телефоне меню вылезало
-- за края и не уменьшалось. Теперь: оконный вид по умолчанию, размер
-- влезает в экран (с учётом отступа топбара Roblox), позиция зажимается
-- в границах, фуллскрин — по кнопке рядом с шестерёнкой.
local MainFrame = Window.Items["MainFrame"].Instance
local WINDOW_MARGIN = 8

local function getViewSize()
    local cam = Workspace.CurrentCamera
    local vp = (cam and cam.ViewportSize and cam.ViewportSize.X > 100)
        and cam.ViewportSize or Vector2.new(1280, 800)
    -- ScreenGui НЕ игнорирует GuiInset: полезная высота меньше
    -- на высоту топбара Roblox (на телефоне это ~58px)
    pcall(function()
        local inset = game:GetService("GuiService"):GetGuiInset()
        vp = Vector2.new(vp.X, vp.Y - inset.Y)
    end)
    return vp
end

-- оконный размер: влезает в экран, но не мельче разумного
local function windowedSize(vp)
    local w = math.clamp(math.min(900, vp.X - 24), 320, 900)
    local h = math.clamp(math.min(600, vp.Y - 90), 240, 600)
    w = math.max(200, math.min(w, vp.X - WINDOW_MARGIN * 2))
    h = math.max(150, math.min(h, vp.Y - WINDOW_MARGIN * 2))
    return math.floor(w), math.floor(h)
end

-- зажимает окно целиком в видимую область (драг/ресайз/поворот)
local function clampWindowOnScreen()
    pcall(function()
        local vp = getViewSize()
        local maxW = math.max(200, vp.X - WINDOW_MARGIN * 2)
        local maxH = math.max(150, vp.Y - WINDOW_MARGIN * 2)
        local w = math.min(MainFrame.Size.X.Offset, maxW)
        local h = math.min(MainFrame.Size.Y.Offset, maxH)
        MainFrame.Size = UDim2.fromOffset(w, h)

        local pos = MainFrame.AbsolutePosition
        local x = math.clamp(pos.X, WINDOW_MARGIN, math.max(WINDOW_MARGIN, vp.X - w - WINDOW_MARGIN))
        local y = math.clamp(pos.Y, WINDOW_MARGIN, math.max(WINDOW_MARGIN, vp.Y - h - WINDOW_MARGIN))
        MainFrame.AnchorPoint = Vector2.new(0, 0)
        MainFrame.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
    end)
end

-- КНОПКА ФУЛЛСКРИНА: растянуть на экран / вернуть оконный вид
local WindowFullscreen = false
local SavedWindowed = nil
local FullBtn = Window.Items["FullBtn"]
local FullBtnFill = Window.Items["FullBtnFill"]
if FullBtn then
    FullBtn:Connect("MouseButton1Click", function()
        local vp = getViewSize()
        WindowFullscreen = not WindowFullscreen
        local fill = FullBtnFill and FullBtnFill.Instance
        if WindowFullscreen then
            local pos = MainFrame.AbsolutePosition
            SavedWindowed = {
                w = MainFrame.Size.X.Offset,
                h = MainFrame.Size.Y.Offset,
                x = pos.X,
                y = pos.Y,
            }
            MainFrame.AnchorPoint = Vector2.new(0, 0)
            MainFrame.Size = UDim2.fromOffset(
                math.max(200, vp.X - WINDOW_MARGIN * 2),
                math.max(150, vp.Y - WINDOW_MARGIN * 2)
            )
            MainFrame.Position = UDim2.fromOffset(WINDOW_MARGIN, WINDOW_MARGIN)
            if fill then
                fill.BackgroundTransparency = 0
            end
            journal("МЕНЮ: ФУЛЛСКРИН")
        else
            local w, h = windowedSize(vp)
            local x = math.max(WINDOW_MARGIN, math.floor((vp.X - w) / 2))
            local y = math.max(WINDOW_MARGIN, math.floor((vp.Y - h) / 2))
            local s = SavedWindowed
            if s and s.w and s.h then
                w = math.min(s.w, math.max(200, vp.X - WINDOW_MARGIN * 2))
                h = math.min(s.h, math.max(150, vp.Y - WINDOW_MARGIN * 2))
            end
            if s and s.x and s.y then
                x = math.clamp(s.x, WINDOW_MARGIN, math.max(WINDOW_MARGIN, vp.X - w - WINDOW_MARGIN))
                y = math.clamp(s.y, WINDOW_MARGIN, math.max(WINDOW_MARGIN, vp.Y - h - WINDOW_MARGIN))
            end
            MainFrame.Size = UDim2.fromOffset(w, h)
            MainFrame.AnchorPoint = Vector2.new(0, 0)
            MainFrame.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
            if fill then
                fill.BackgroundTransparency = 1
            end
            journal("МЕНЮ: ОКОННЫЙ РЕЖИМ")
        end
    end)
end

