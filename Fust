-- V11: разовая зачистка мира от следов зомби-циклов СТАРЫХ версий:
-- корень-«куб» (X==Y==Z, >=3) — сигнатура нашего расширителя,
-- возвращаем к стандартным 2х2х1; левые чамсы уничтожаем.
pcall(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        local c = plr.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if root then
            local s = root.Size
            if s.X == s.Y and s.Y == s.Z and s.X >= 3 then
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
                root.CanCollide = true
                root.CanQuery = true
            end
        end
        local hl = c and c:FindFirstChild("VOMAGLA_Chams")
        if hl then
            hl:Destroy()
        end
    end
end)

