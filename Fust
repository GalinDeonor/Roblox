        local coreGui = game:GetService("CoreGui")
        gui.Instance.Parent = coreGui
        if gui.Instance.Parent ~= coreGui then
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pg then
                gui.Instance.Parent = pg
                gui.Instance.DisplayOrder = 999999
            end
        else
            gui.Instance.DisplayOrder = 999999
        end
    end
    reparent(Library.Holder)
    reparent(Library.UnusedHolder)
